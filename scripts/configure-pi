#!/usr/bin/env python3
"""Import only DeepSeek into Pi's guest gateway; never resets request ledgers."""
import argparse,json,os,pathlib,re
from decimal import Decimal
def token_count(text):
 value=str(text).strip().upper()
 if not re.fullmatch(r"[0-9]+(?:\.[0-9]+)?[KM]?",value):raise argparse.ArgumentTypeError("Use a positive token count, e.g. 128K or 1M")
 suffix=value[-1:]
 count=Decimal(value[:-1] if suffix in ("K","M") else value)*({"K":1000,"M":1000000}.get(suffix,1))
 if count!=count.to_integral_value() or not 1<=count<=9007199254740991:raise argparse.ArgumentTypeError("Token count must be a positive exact JSON integer")
 return int(count)
parser=argparse.ArgumentParser()
parser.add_argument('--request-limit',type=int,default=10000)
parser.add_argument('--max-tokens',type=token_count,default=8192)
parser.add_argument('--requests-per-turn',type=int,default=100)
parser.add_argument('--parallel-tasks',type=int,default=5)
a=parser.parse_args()
if not (0<=a.request_limit<=1000000 and 1<=a.max_tokens<=9007199254740991 and 1<=a.requests_per_turn<=1000 and 1<=a.parallel_tasks<=1000):parser.error('Invalid limits')
p=json.loads((pathlib.Path.home()/'.pi/agent/models.json').read_text())['providers']['deepseek']
if p.get('baseUrl','').rstrip('/')!='https://api.deepseek.com':raise SystemExit('Unexpected DeepSeek endpoint')
if not any(m.get('id')=='deepseek-v4-flash' for m in p.get('models',[])):raise SystemExit('Flash model missing')
key=p.get('apiKey','')
if key.startswith('!'):raise SystemExit('Command-based credentials are not imported')
if re.fullmatch(r'[A-Z_][A-Z0-9_]*',key):key=os.environ.get(key,'')
if not key:raise SystemExit('DeepSeek credential unavailable')
repo=pathlib.Path(__file__).resolve().parents[1]
root=pathlib.Path(os.environ.get('POT_LOCAL_ROOT',repo/'.local/d1/local-runtime'))
path=root/'workspace/product/pi.json';path.parent.mkdir(parents=True,exist_ok=True)
temp=path.with_suffix('.tmp');fd=os.open(temp,os.O_WRONLY|os.O_CREAT|os.O_TRUNC,0o600);os.fchmod(fd,0o600)
with os.fdopen(fd,'w') as f:
 json.dump(dict(api_key=key,model='deepseek-v4-flash',request_limit=a.request_limit,max_tokens=a.max_tokens,max_requests_per_turn=a.requests_per_turn,max_parallel_tasks=a.parallel_tasks),f);f.flush();os.fsync(f.fileno())
os.replace(temp,path)
print(f'Pi configured privately: DeepSeek Flash, request cap {a.request_limit}, output cap {a.max_tokens}, {a.requests_per_turn} requests/turn. Existing ledgers preserved. No model request made.')
