#!/usr/bin/env python3
"""Synchronize generated plugin packages from declared capability files."""

import argparse
from pathlib import Path
import platform

from go_packaging import BUILD, NODE_HASHES, prepare_plugins

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument(
    "--platform",
    choices=NODE_HASHES,
    default={
        "Darwin": "darwin-arm64",
        "Linux": "linux-"
        + {"x86_64": "amd64", "aarch64": "arm64"}.get(platform.machine(), "unsupported"),
    }.get(platform.system()),
)
parser.add_argument(
    "--output",
    type=Path,
    default=BUILD / "runtime-resources/plugins",
    help="Dedicated generated directory; its contents are replaced on each build",
)
args = parser.parse_args()
prepare_plugins(args.output, args.platform)
print(args.output.resolve())
