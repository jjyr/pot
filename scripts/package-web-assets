#!/usr/bin/env python3
"""Incrementally compress generated Web assets with the external Brotli CLI."""

import argparse
import hashlib
import json
from pathlib import Path
import shutil
import subprocess
import os

ROOT = Path(__file__).resolve().parents[1]
NAMES = [
    "index.html",
    "locales.json",
    "OFL.txt",
    "sw.js",
    "manifest.json",
    "icon.png",
    "icon-192.png",
    "icon-512.png",
    "install.js",
    "auth.js",
    "style.css",
    "pkg/pot_web_ui.js",
    "pkg/pot_web_ui_bg.wasm",
    "font.ttf",
]


def digest(data):
    return hashlib.sha256(data).hexdigest()


def sources():
    paths = [
        ROOT / name
        for name in [
            "Cargo.toml",
            "Cargo.lock",
            "scripts/build-web-ui",
            "scripts/localize-web",
            "scripts/package-web-assets",
            "mise.toml",
            "crates/sandbox-images/linux/default/index.template.html",
            "crates/app/assets/PotHomeScreen.png",
            "crates/app/assets/PotHomeScreen-192.png",
            "crates/app/assets/PotHomeScreen-512.png",
        ]
    ]
    for directory in [
        "crates/web-ui",
        "crates/ui",
        "crates/core",
        "crates/protocol",
        "crates/localization",
        "crates/app/locales",
        "desktop",
    ]:
        paths.extend(
            p
            for p in (ROOT / directory).rglob("*")
            if p.is_file()
            and not {"dist", "target", "__pycache__"}.intersection(p.relative_to(ROOT).parts)
        )
    return {p.relative_to(ROOT).as_posix(): digest(p.read_bytes()) for p in sorted(set(paths))}


def read_manifest(path):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return {}


def write_changed(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.is_file() and path.read_bytes() == data:
        return
    temporary = path.with_name(path.name + ".tmp")
    temporary.write_bytes(data)
    temporary.replace(path)


def payloads_valid(directory, entries):
    return bool(entries) and all(
        (directory / name).is_file() and digest((directory / name).read_bytes()) == value
        for name, value in entries.items()
    )


def compress(dist, output):
    executable = shutil.which("brotli")
    if executable is None:
        raise SystemExit(
            "Brotli CLI is required for web-ui. Install brotli (developers: mise install), or use --no-default-features."
        )
    version = subprocess.check_output([executable, "--version"], text=True).strip()
    previous = read_manifest(output / "manifest.json")
    profile = {"version": version, "quality": 11}
    names = sorted(
        NAMES + [p.relative_to(dist).as_posix() for p in (dist / "desktop-assets").rglob("*.js")]
    )
    assert any(name.startswith("desktop-assets/") for name in names), "Missing noVNC assets"
    manifest = {
        "encoding": "br",
        "profile": profile,
        "compressor": executable,
        "sources": sources(),
        "assets": {},
    }
    reused = 0
    for name in names:
        raw = (dist / name).read_bytes()
        raw_hash = digest(raw)
        dest = output / (name + ".br")
        old = previous.get("assets", {}).get(name, {})
        if (
            previous.get("profile") == profile
            and old.get("raw_sha256") == raw_hash
            and dest.is_file()
            and digest(dest.read_bytes()) == old.get("sha256")
        ):
            reused += 1
            manifest["assets"][name] = old
            continue
        # Stream via stdin/stdout so no original file name or mtime is included.
        encoded = subprocess.check_output([executable, "--quality=11", "--stdout"], input=raw)
        assert (
            subprocess.check_output([executable, "--decompress", "--stdout"], input=encoded) == raw
        )
        write_changed(dest, encoded)
        manifest["assets"][name] = {
            "sha256": digest(encoded),
            "raw_sha256": raw_hash,
            "compressed_bytes": len(encoded),
            "raw_bytes": len(raw),
        }
    for path in output.rglob("*.br"):
        if path.relative_to(output).as_posix()[:-3] not in manifest["assets"]:
            path.unlink()
    write_changed(
        output / "manifest.json", (json.dumps(manifest, indent=2, sort_keys=True) + "\n").encode()
    )
    print(
        f"Web compression: {reused}/{len(names)} cached, {len(names) - reused} compressed",
        flush=True,
    )


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--cache-dir",
        type=Path,
        default=Path(os.environ.get("CARGO_TARGET_DIR", ROOT / "target")) / "pot-web",
    )
    args = parser.parse_args()
    compress(args.cache_dir / "dist", args.cache_dir / "compressed")


if __name__ == "__main__":
    main()
