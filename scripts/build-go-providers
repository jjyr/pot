#!/usr/bin/env python3
"""Build the installed provider packages independently of App and guest images."""

import argparse
from pathlib import Path
import platform

from go_packaging import BUILD, NODE_HASHES, prepare_providers

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument(
    "--platform",
    choices=NODE_HASHES,
    default={
        "Darwin": "darwin-arm64",
        "Linux": "linux-"
        + {"x86_64": "amd64", "aarch64": "arm64"}.get(platform.machine(), "unsupported"),
    }.get(platform.system()),
)
parser.add_argument("--output", type=Path, default=BUILD / "runtime-resources/providers")
args = parser.parse_args()
prepare_providers(args.output.resolve(), args.platform)
print(args.output.resolve())
