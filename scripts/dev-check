#!/usr/bin/env python3
"""Shared local/hook checks. Never boot a VM or call a model."""

import ast
import os
from pathlib import Path
import platform
import shutil
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
os.chdir(ROOT)


def run(*args):
    result = subprocess.run(args)
    if result.returncode:
        raise SystemExit(result.returncode)


def doctor():
    if platform.system() != "Darwin" or platform.machine() != "arm64":
        raise SystemExit("Pot App development requires Apple Silicon macOS.")
    if int(platform.mac_ver()[0].split(".")[0]) < 26:
        raise SystemExit("macOS 26+ is required.")
    swift = subprocess.check_output(["xcrun", "swift", "--version"], text=True)
    import re

    match = re.search(r"Swift version (\d+)\.(\d+)", swift)
    if not match or tuple(map(int, match.groups())) < (6, 2):
        raise SystemExit("Select Xcode with Swift 6.2+ using xcode-select.")
    print(swift.strip())
    for binary in [
        "go",
        "node",
        "python",
        "hk",
        "pkl",
        "ruff",
        "shfmt",
        "shellcheck",
        "swiftformat",
    ]:
        if not shutil.which(binary):
            raise SystemExit(f"Missing {binary}; run mise install.")
    if not shutil.which("podman"):
        raise SystemExit(
            "Missing Podman; install it before Linux Sandbox development. No machine is created or started by doctor."
        )
    run("podman", "--version")
    run("go", "version")
    run("node", "--version")
    print("Development prerequisites OK. No downloads, VM or model calls performed.")


def sources(args):
    config_files = {"mise.toml", "ruff.toml", ".swiftformat", "hk.pkl", "scripts/dev-check"}
    if args and not config_files.intersection(args):
        candidates = args
    else:
        candidates = (
            subprocess.check_output(
                ["git", "ls-files", "--cached", "--others", "--exclude-standard", "-z"]
            )
            .decode()
            .split("\0")
        )
    groups = {kind: [] for kind in ["go", "swift", "python", "shell"]}
    for name in sorted(set(candidates)):
        path = Path(name)
        if not path.is_file() or path.is_symlink():
            continue
        kind = {".go": "go", ".swift": "swift", ".py": "python", ".sh": "shell"}.get(path.suffix)
        if not kind and path.parent == Path("scripts"):
            first = path.read_bytes().split(b"\n", 1)[0]
            if first.startswith(b"#!") and b"python" in first:
                kind = "python"
        if kind:
            groups[kind].append(name)
    return groups


def check(mode, args):
    files = sources(args)
    if mode == "lint":
        run("python", "scripts/localize-web", "--check")
    fix = mode == "fmt"
    if files["go"]:
        if fix:
            run("gofmt", "-w", *files["go"])
        else:
            unformatted = subprocess.check_output(["gofmt", "-l", *files["go"]], text=True)
            if unformatted:
                raise SystemExit("Run gofmt on:\n" + unformatted)
    if files["swift"]:
        run("swiftformat", *files["swift"], *([] if fix else ["--lint", "--strict"]))
    if files["python"]:
        run("ruff", "format", *([] if fix else ["--check"]), *files["python"])
        if not fix:
            run("ruff", "check", *files["python"])
            for name in files["python"]:
                ast.parse(Path(name).read_text(), filename=name)
    if files["shell"]:
        run("shfmt", "-w" if fix else "-d", "-i", "2", "-ci", *files["shell"])
        if not fix:
            run("shellcheck", "--severity=warning", *files["shell"])
            for name in files["shell"]:
                run("sh", "-n", name)


if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in {"doctor", "fmt", "lint"}:
        raise SystemExit("Usage: scripts/dev-check doctor|fmt|lint [FILES...]")
    if sys.argv[1] == "doctor":
        doctor()
    else:
        check(sys.argv[1], sys.argv[2:])
