#!/usr/bin/env python3
"""Propose cask and Formula updates from already published macOS archives."""

import argparse
import base64
import json
import os
from pathlib import Path
import re
import subprocess
import tempfile
from urllib.parse import quote

from release_contract import checksum, generate_cask, generate_formula, version_number
from release_transport import diagnostic, run as github_run


def api(repository, endpoint, data=None, missing=False):
    command = ["gh", "api", f"repos/{repository}/{endpoint}".rstrip("/")]
    if data is not None:
        command += ["--method", "POST", "--input", "-"]
    try:
        result = github_run(
            command,
            read_only=data is None,
            timeout=30,
            input=json.dumps(data) if data is not None else None,
            capture_output=True,
            text=True,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise RuntimeError(f"GitHub {endpoint}: {diagnostic(error)}") from error
    if result.returncode:
        if missing and result.stdout:
            error = json.loads(result.stdout)
            if str(error.get("status")) == "404":
                return None
        raise RuntimeError(f"GitHub {endpoint}: {diagnostic(result)}")
    return json.loads(result.stdout)


def propose(repository, version, cask, formula):
    """Create a branch once. Never update an existing branch, PR, or default ref."""
    base = api(repository, "")["default_branch"]
    base_sha = api(repository, f"commits/{quote(base, safe='')}")["sha"]
    desired = {"Casks/pot.rb": cask, "Formula/pot-cli.rb": formula}
    changes = {}
    for path, text in desired.items():
        current = api(repository, f"contents/{path}?ref={base_sha}")
        current_text = base64.b64decode(current["content"]).decode()
        if current_text == text:
            continue
        current_version = re.search(r'^  version "([0-9.]+)"$', current_text, re.M)
        if current_version and tuple(map(int, current_version[1].split("."))) >= tuple(
            map(int, version.split("."))
        ):
            raise ValueError("Refusing to replace an equal or newer default-branch package")
        changes[path] = text
    if not changes:
        return "Homebrew packages already synchronized on the default branch."
    branch = f"homebrew/pot-v{version}"
    prs = api(
        repository,
        f"pulls?state=all&head={quote(repository.split('/')[0] + ':' + branch, safe='')}&per_page=100",
    )
    for pr in prs:
        if pr["base"]["ref"] != base:
            raise ValueError("Existing Homebrew PR targets a different base; review it manually")
        if pr["state"] == "closed":
            raise ValueError(
                "Homebrew PR was closed or merged; review default-branch state manually"
            )
    existing = api(repository, f"git/ref/heads/{branch}", missing=True)
    if existing:
        for path, text in desired.items():
            content = api(repository, f"contents/{path}?ref={existing['object']['sha']}")
            if base64.b64decode(content["content"]).decode() != text:
                raise ValueError("Existing Homebrew branch differs; refusing to rewrite it")
        comparison = api(repository, f"compare/{base_sha}...{existing['object']['sha']}")
        if sorted(f["filename"] for f in comparison["files"]) != sorted(changes):
            raise ValueError("Existing branch contains other changes; review it manually")
    else:
        commit = api(repository, f"git/commits/{base_sha}")
        tree = api(
            repository,
            "git/trees",
            {
                "base_tree": commit["tree"]["sha"],
                "tree": [
                    {"path": path, "mode": "100644", "type": "blob", "content": text}
                    for path, text in changes.items()
                ],
            },
        )
        commit = api(
            repository,
            "git/commits",
            {
                "message": f"Update Homebrew packages to Pot {version}",
                "tree": tree["sha"],
                "parents": [base_sha],
            },
        )
        api(repository, "git/refs", {"ref": "refs/heads/" + branch, "sha": commit["sha"]})
    if prs:
        return "Existing Homebrew PR: " + prs[0]["html_url"]
    print(f"Verified Homebrew branch: https://github.com/{repository}/tree/{branch}")
    pr = api(
        repository,
        "pulls",
        {
            "title": f"Update Homebrew packages to Pot {version}",
            "head": branch,
            "base": base,
            "body": (
                f"Install Pot {version} from the published App ZIP and CLI archive. The shared generators "
                "verified package versions, checksum sidecars and GitHub asset digests against the final bytes.\n\n"
                "This updates Casks/pot.rb and Formula/pot-cli.rb. Merge after review to enable Homebrew installation/upgrades; "
                "the release tag and assets remain immutable. Homebrew preserves quarantine."
            ),
        },
    )
    return "Created Homebrew PR: " + pr["html_url"]


def verify_tag(repository, version, revision):
    """Check the immutable annotated source binding without preparation artifacts."""
    tag = "v" + version
    ref = api(repository, f"git/ref/tags/{tag}")
    target = ref.get("object") or {}
    if target.get("type") != "tag" or not re.fullmatch(r"[a-f0-9]{40}", target.get("sha") or ""):
        raise ValueError("Homebrew requires an annotated release tag")
    annotated = api(repository, "git/tags/" + target["sha"])
    if (
        annotated.get("tag") != tag
        or (annotated.get("object") or {}).get("type") != "commit"
        or annotated["object"].get("sha") != revision
    ):
        raise ValueError("Release tag moved after validation")
    try:
        binding = json.loads(annotated.get("message", ""))
    except ValueError as error:
        raise ValueError("Release tag has no candidate binding") from error
    if (
        not isinstance(binding, dict)
        or binding.get("format") != 1
        or binding.get("version") != version
        or binding.get("sha") != revision
    ):
        raise ValueError("Release tag candidate binding differs")
    return target["sha"]


def sync(version, revision, repository):
    version = version_number(version)
    if repository != "jjyr/pot" or not re.fullmatch(r"[a-f0-9]{40}", revision):
        raise ValueError("Expected jjyr/pot and a validated full release SHA")
    tag = "v" + version
    tag_object = verify_tag(repository, version, revision)
    release = api(repository, f"releases/tags/{tag}")
    if release["draft"] or release["prerelease"]:
        raise ValueError("Homebrew sync requires a published stable release")
    names = [f"Pot-{version}-arm64.zip", f"pot-{version}-darwin-arm64.tar.gz"]
    assets = {a["name"]: a for a in release["assets"] if a["name"] in names}
    if set(assets) != set(names):
        raise ValueError("Published release is missing a final macOS archive")
    with tempfile.TemporaryDirectory(prefix="pot-cask-") as temporary:
        output = Path(temporary)
        subprocess.run(
            [
                "gh",
                "release",
                "download",
                tag,
                "--repo",
                repository,
                *[
                    arg
                    for name in names
                    for arg in ("--pattern", name, "--pattern", name + ".sha256")
                ],
                "--dir",
                temporary,
            ],
            check=True,
        )
        for name, asset in assets.items():
            archive = output / name
            if (
                asset.get("digest") != "sha256:" + checksum(archive)
                or asset["size"] != archive.stat().st_size
            ):
                raise ValueError("Downloaded archive does not match published asset digest/size")
        generate_cask(version, output)
        generate_formula(version, output)
        if verify_tag(repository, version, revision) != tag_object:
            raise ValueError("Release tag moved before Homebrew proposal")
        return propose(
            repository,
            version,
            (output / "pot.rb").read_text(),
            (output / "pot-cli.rb").read_text(),
        )


def source_from_publish(run_id, repository):
    """Resolve data from a successful trusted publisher, never execute its source."""
    from release_candidate import inspect_candidate

    if repository != "jjyr/pot" or type(run_id) is not int or run_id <= 0:
        raise ValueError("Expected jjyr/pot and a positive publication run ID")
    run = api(repository, f"actions/runs/{run_id}")
    workflow = api(repository, "actions/workflows/release-publish.yml")
    default = api(repository, "")["default_branch"]
    if (
        run.get("id") != run_id
        or run.get("workflow_id") != workflow.get("id")
        or workflow.get("state") != "active"
        or workflow.get("path") != ".github/workflows/release-publish.yml"
        or run.get("path") != workflow["path"]
        or run.get("event") != "workflow_dispatch"
        or run.get("head_branch") != default
        or run.get("status") != "completed"
        or run.get("conclusion") != "success"
        or not re.fullmatch(r"[a-f0-9]{40}", run.get("head_sha") or "")
        or type(run.get("run_attempt")) is not int
        or run["run_attempt"] <= 0
        or any(
            (run.get(key) or {}).get("full_name") != repository
            for key in ("repository", "head_repository")
        )
    ):
        raise ValueError("Homebrew requires a successful trusted default-branch publication")
    marker = re.fullmatch(
        r"release-publish \[([a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12})\] prepare=([1-9][0-9]*) manifest=([1-9][0-9]*)",
        run.get("display_title") or "",
    )
    if marker is None:
        raise ValueError("Publication has no valid pinned candidate identity")
    prepare_id, manifest_id = int(marker[2]), int(marker[3])
    candidate = inspect_candidate(prepare_id, manifest_id)
    if candidate.get("run_id") != prepare_id or candidate.get("manifest_id") != manifest_id:
        raise ValueError("Publication candidate identity mismatch")
    return candidate["version"], candidate["sha"]


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("version", nargs="?")
    parser.add_argument("revision", nargs="?")
    parser.add_argument("--publish-run-id", type=int)
    args = parser.parse_args(argv)
    repository = os.environ["GITHUB_REPOSITORY"]
    if args.publish_run_id is not None:
        if args.version is not None or args.revision is not None or args.publish_run_id <= 0:
            parser.error("Use either VERSION REVISION or a positive --publish-run-id")
        version, revision = source_from_publish(args.publish_run_id, repository)
    else:
        if args.version is None or args.revision is None:
            parser.error("VERSION and REVISION are required without --publish-run-id")
        version, revision = args.version, args.revision
    print(sync(version, revision, repository))


if __name__ == "__main__":
    main()
