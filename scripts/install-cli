#!/usr/bin/env python3
"""Install an already-built CLI binary without changing services or instance data."""

from pathlib import Path
import argparse
import shutil

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("binary", type=Path)
parser.add_argument("--prefix", type=Path, default=Path.home() / ".local")
parser.add_argument("--runtime-resources", type=Path)
parser.add_argument("--helper", type=Path)
args = parser.parse_args()
if bool(args.runtime_resources) != bool(args.helper):
    parser.error("--runtime-resources and --helper must be supplied together")
source = args.binary.resolve(strict=True)
assert source.is_file(), "Expected the release pot binary"
dest = args.prefix.expanduser() / "bin/pot"
dest.parent.mkdir(parents=True, exist_ok=True)
temp = dest.with_suffix(".new")
shutil.copy2(source, temp)
temp.chmod(0o755)
if args.runtime_resources:
    resources = args.prefix.expanduser() / "lib/pot"
    resources.mkdir(parents=True, exist_ok=True)
    assert not (resources / "runtime").exists(), (
        "Provider already installed; use a versioned prefix for upgrades"
    )
    shutil.copytree(args.runtime_resources.resolve(strict=True), resources / "runtime")
    shutil.copy2(args.helper.resolve(strict=True), resources / "PotHelper")
    (resources / "PotHelper").chmod(0o755)
temp.replace(dest)
print(f"Installed {dest}. Add {dest.parent} to PATH. Use pot --help to get started.")
