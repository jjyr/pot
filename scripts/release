#!/usr/bin/env python3
"""Build a release ZIP, checksum and matching Homebrew cask."""

import argparse
import hashlib
import os
from pathlib import Path
import platform
import plistlib
import re
import shutil
import subprocess

REPO = Path(__file__).resolve().parents[1]
APP = REPO / ".local/go/Pot.app"


def package(app, output, version):
    info = plistlib.loads((app / "Contents/Info.plist").read_bytes())
    if info.get("CFBundleShortVersionString") != version:
        raise SystemExit("Bundle version does not match release version")
    runtime = app / "Contents/Resources"
    for name in ["vmlinux", "init-image", "sandbox-image", "sandbox-image.json"]:
        if (runtime / name).exists():
            raise SystemExit("Release must not embed Sandbox resources: " + name)
    output.mkdir(parents=True, exist_ok=True)
    archive = output / f"Pot-{version}-arm64.zip"
    archive.unlink(missing_ok=True)
    subprocess.run(
        ["ditto", "-c", "-k", "--sequesterRsrc", "--keepParent", str(app), str(archive)],
        check=True,
    )
    with archive.open("rb") as source:
        digest = hashlib.file_digest(source, "sha256").hexdigest()
    (output / f"{archive.name}.sha256").write_text(f"{digest}  {archive.name}\n")
    template = (REPO / "packaging/homebrew/pot.rb.in").read_text()
    (output / "pot.rb").write_text(
        template.replace("@VERSION@", version).replace("@SHA256@", digest)
    )
    print(archive)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("version", help="Release version, e.g. 0.1.0 or v0.1.0")
    parser.add_argument("--output", type=Path, default=REPO / ".local/releases")
    args = parser.parse_args()
    version = args.version.removeprefix("v")
    if not re.fullmatch(r"\d+\.\d+\.\d+", version):
        parser.error("version must be a numeric major.minor.patch version")
    if platform.system() != "Darwin" or platform.machine() != "arm64":
        parser.error("release builds require Apple Silicon macOS")
    env = dict(os.environ, POT_APP_RELEASE="1", POT_APP_VERSION=version)
    subprocess.run(["python3", str(REPO / "scripts/build-go-app")], check=True, env=env)
    package(APP, args.output.resolve(), version)


if __name__ == "__main__":
    main()
