#!/usr/bin/env python3
"""Build a release ZIP, checksum and matching Homebrew cask."""

import argparse
import os
from pathlib import Path
import platform
import plistlib
import subprocess

from release_contract import generate_cask, version_number, write_checksum

REPO = Path(__file__).resolve().parents[1]
APP = REPO / ".local/pot/Pot.app"


def package(app, output, version):
    info = plistlib.loads((app / "Contents/Info.plist").read_bytes())
    if info.get("CFBundleShortVersionString") != version:
        raise SystemExit("Bundle version does not match release version")
    runtime = app / "Contents/Resources"
    for name in ["sandbox-image", "sandbox-image.json"]:
        if (runtime / name).exists():
            raise SystemExit("Release must not embed Sandbox resources: " + name)
    output.mkdir(parents=True, exist_ok=True)
    archive = output / f"Pot-{version}-arm64.zip"
    archive.unlink(missing_ok=True)
    subprocess.run(
        ["ditto", "-c", "-k", "--sequesterRsrc", "--keepParent", str(app), str(archive)],
        check=True,
    )
    write_checksum(archive)
    generate_cask(version, output)
    print(archive)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("version", help="Release version, e.g. 0.1.0 or v0.1.0")
    parser.add_argument("--output", type=Path, default=REPO / ".local/releases")
    parser.add_argument("--app-only", action="store_true", help="Build only the macOS App archive")
    args = parser.parse_args()
    try:
        version = version_number(args.version)
    except ValueError as error:
        parser.error(str(error))
    if platform.system() != "Darwin" or platform.machine() != "arm64":
        parser.error("release builds require Apple Silicon macOS")
    env = dict(os.environ, POT_APP_RELEASE="1", POT_APP_VERSION=version)
    subprocess.run(["python3", str(REPO / "scripts/build-pot-app")], check=True, env=env)
    package(APP, args.output.resolve(), version)
    if args.app_only:
        return
    for target in ["darwin-arm64", "linux-amd64", "linux-arm64"]:
        subprocess.run(
            [
                "python3",
                str(REPO / "scripts/package-server"),
                "--platform",
                target,
                "--output",
                str(args.output.resolve()),
            ],
            check=True,
            env=env,
        )
    if os.environ.get("POT_UPDATE_PUBLIC_KEY"):
        subprocess.run(
            ["python3", str(REPO / "scripts/update-release"), version, str(args.output.resolve())],
            check=True,
        )


if __name__ == "__main__":
    main()
