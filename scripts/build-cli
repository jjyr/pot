#!/usr/bin/env python3
"""Build a self-contained Pot CLI release. No App is required to install or run it."""

from pathlib import Path
import os
import subprocess
import tarfile
import argparse

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--runtime-resources", type=Path)
parser.add_argument("--helper", type=Path)
args = parser.parse_args()
if bool(args.runtime_resources) != bool(args.helper):
    parser.error("--runtime-resources and --helper must be supplied together")

root = Path(__file__).resolve().parents[1]
subprocess.run(["mise", "run", "build:mobile"], cwd=root, check=True)
subprocess.run(
    [
        "mise",
        "exec",
        "--",
        "cargo",
        "build",
        "--release",
        "--locked",
        "-p",
        "pot-server",
        "--bin",
        "pot",
        "--features",
        "embedded-web",
        "-j",
        "4",
    ],
    cwd=root,
    check=True,
)
target = Path(os.environ.get("CARGO_TARGET_DIR", root / ".local/poc/cargo-target"))
dest = root / ".local/releases"
dest.mkdir(parents=True, exist_ok=True)
archive = dest / f"pot-{os.uname().sysname.lower()}-{os.uname().machine}.tar.gz"
with tarfile.open(archive, "w:gz") as tar:
    tar.add(target / "release/pot", arcname="bin/pot")
    tar.add(root / "docs/standalone-server.md", arcname="README.md")
    tar.add(root / "skills", arcname="lib/pot/skills")
    if args.runtime_resources:
        tar.add(args.runtime_resources.resolve(strict=True), arcname="lib/pot/runtime")
        tar.add(args.helper.resolve(strict=True), arcname="lib/pot/PotHelper")
print(archive)
