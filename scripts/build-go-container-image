#!/usr/bin/env python3
"""Build a rootless Podman guest containing only the Go Pot executor."""

import argparse
import hashlib
import os
from pathlib import Path
import platform
import shutil
import subprocess
import urllib.request

ROOT = Path(__file__).resolve().parents[1]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument(
    "--arch",
    choices=["amd64", "arm64"],
    default={"x86_64": "amd64", "aarch64": "arm64", "arm64": "arm64"}.get(platform.machine()),
)
parser.add_argument("--tag", default="localhost/pot-go-sandbox:development")
parser.add_argument("--prepare-only", action="store_true")
args = parser.parse_args()
if not args.arch:
    parser.error("Specify --arch for this host")
context = ROOT / ".local/go/container-image" / args.arch
assets = context / "assets"
assets.mkdir(parents=True, exist_ok=True)
recipe = ROOT / "resources/sandbox/linux/default"
subprocess.run(["python", ROOT / "scripts/localize-web"], cwd=ROOT, check=True)
for source in recipe.iterdir():
    if source.suffix in {".sh", ".py", ".html", ".svg", ".lock"} and not source.name.endswith(
        ".template.html"
    ):
        shutil.copy2(source, assets / source.name)
for source in (ROOT / ".local/web/sandbox").iterdir():
    shutil.copy2(source, assets / source.name)
shutil.copy2(recipe / "Dockerfile", context / "Dockerfile")
subprocess.run(
    [
        "go",
        "build",
        "-trimpath",
        "-ldflags=-s -w",
        "-o",
        assets / "pot-tool-executor",
        "./cmd/pot-tool-executor",
    ],
    cwd=ROOT,
    env={**os.environ, "GOOS": "linux", "GOARCH": args.arch, "CGO_ENABLED": "0"},
    check=True,
)
archive = ROOT / ".local/go/resources/novnc.tar.gz"
archive.parent.mkdir(parents=True, exist_ok=True)
if not archive.exists():
    with (
        urllib.request.urlopen(
            "https://github.com/novnc/noVNC/archive/refs/tags/v1.7.0.tar.gz", timeout=120
        ) as source,
        archive.open("wb") as target,
    ):
        shutil.copyfileobj(source, target)
if (
    hashlib.sha256(archive.read_bytes()).hexdigest()
    != "b1003a11b6e6e8d8f7f5e5586daae7f8ca651d8aee0aa155ff9ac841c48f52c6"
):
    raise SystemExit("noVNC checksum mismatch")
shutil.copy2(archive, assets / "novnc.tar.gz")
if not args.prepare_only:
    subprocess.run(
        [
            "podman",
            "--remote=false",
            "build",
            "--format=oci",
            "--network=private",
            "--platform=linux/" + args.arch,
            "--file",
            context / "Dockerfile",
            "--tag",
            args.tag,
            context,
        ],
        cwd=ROOT,
        check=True,
    )
print(context)
