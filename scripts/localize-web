#!/usr/bin/env python3
"""Build desktop templates and page-specific locale resources; never modify sources."""

import argparse
import html
import json
from pathlib import Path
import re

ROOT = Path(__file__).resolve().parents[1]


def catalogs(root):
    values = {
        path.stem: json.loads(path.read_text())
        for path in sorted((root / "resources/app/locales").glob("*.json"))
    }
    english = values["en"]
    for locale, translations in values.items():
        if translations.keys() != english.keys():
            raise ValueError(f"Translation keys differ: {locale}")
        for key, value in translations.items():
            if not isinstance(value, str) or not value:
                raise ValueError(f"Empty translation: {locale}: {key}")
            parameters = lambda text: re.findall(r"(?<!\{)\{([^{}]*)\}(?!\})", text)
            if parameters(value) != parameters(english[key]):
                raise ValueError(f"Parameter mismatch: {locale}: {key}")
    return values


def build(root, output, check=False):
    translations = catalogs(root)
    for page, directory in [
        ("desktop", "desktop"),
        ("sandbox", "plugins/podman/image"),
    ]:
        template = root / directory / "index.template.html"
        source = template.read_text()
        keys = set(re.findall(r'data-pot-(?:i18n|title|aria-label)="([^"]+)"', source))
        keys.update(re.findall(r"['\"](web\.[\w.-]+)['\"]", source))
        missing = keys - translations["en"].keys()
        if missing:
            raise ValueError(f"Missing translations in {template}: {sorted(missing)}")
        assets = {
            "index.html": source,
            "i18n.js": (root / "desktop/i18n.js").read_text(),
            "locales.json": json.dumps(
                {
                    locale: {key: values[key] for key in sorted(keys)}
                    for locale, values in translations.items()
                },
                ensure_ascii=False,
                indent=2,
            )
            + "\n",
        }
        # Templates have English fallback labels; reject accidental stale defaults.
        for _, key, text in re.findall(
            r'(<span[^>]*data-pot-i18n="([^"]+)"[^>]*>)([^<]*)</span>', source
        ):
            if html.unescape(text) != translations["en"][key]:
                raise ValueError(f"Stale English template label: {template}: {key}")
        if not check:
            dest = output / page
            dest.mkdir(parents=True, exist_ok=True)
            for name, content in assets.items():
                (dest / name).write_text(content)
    return translations


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, default=ROOT)
    parser.add_argument("--output", type=Path, default=ROOT / ".local/web")
    parser.add_argument(
        "--check",
        action="store_true",
        help="Validate source catalogs and templates without writing",
    )
    args = parser.parse_args()
    build(args.root, args.output, args.check)


if __name__ == "__main__":
    main()
