#!/usr/bin/env python3
"""Add immutable assets for one qualified channel to the version's GitHub Release."""

import argparse
import json
import os
from pathlib import Path
import subprocess
import tempfile

from release_contract import (
    checksum,
    checksum_name,
    distribution_names,
    macos_release_notes,
    release_assets,
    version_number,
)


def publish(version, output, channel, macos_mode=None):
    version = version_number(version)
    repository = os.environ["GITHUB_REPOSITORY"]
    tag = "v" + version
    sha = subprocess.check_output(
        ["gh", "api", f"repos/{repository}/commits/refs/tags/{tag}", "--jq", ".sha"], text=True
    ).strip()
    if sha != os.environ["RELEASE_SHA"]:
        raise ValueError("Release tag moved after validation")
    assets = [output / name for name in release_assets(version, channel)]
    for path in assets:
        if not path.is_file():
            raise ValueError(f"missing channel asset: {path.name}")
    if channel == "macos":
        expected = macos_release_notes(version, sha, macos_mode)
        if (output / "MACOS-RELEASE.txt").read_text() != expected:
            raise ValueError(
                "macOS release mode, version or commit does not match validated metadata"
            )
    elif macos_mode is not None:
        raise ValueError("macOS mode is only valid for the macOS channel")
    # Require the complete manifest, including feed and mode disclosure.
    names = distribution_names(version, channel)
    if channel == "macos":
        names += ["update.json", "MACOS-RELEASE.txt"]
    expected = "".join(f"{checksum(output / name)}  {name}\n" for name in names)
    if (output / checksum_name(channel)).read_text() != expected:
        raise ValueError("channel checksum manifest does not match complete asset set")
    for name in distribution_names(version, channel):
        if (output / (name + ".sha256")).read_text() != f"{checksum(output / name)}  {name}\n":
            raise ValueError(f"checksum sidecar mismatch: {name}")

    def get_release():
        result = subprocess.run(
            ["gh", "api", f"repos/{repository}/releases/tags/{tag}"], capture_output=True, text=True
        )
        if result.returncode == 0:
            return json.loads(result.stdout)
        if result.stdout and json.loads(result.stdout).get("status") in (404, "404"):
            return None
        raise RuntimeError("Cannot read release metadata: " + result.stderr)

    def identical(path, release):
        asset = next((a for a in release["assets"] if a["name"] == path.name), None)
        if asset is None:
            return False
        if (
            asset.get("digest") != "sha256:" + checksum(path)
            or asset["size"] != path.stat().st_size
        ):
            raise ValueError(f"Refusing to replace existing release asset: {path.name}")
        return True

    release = get_release()
    if release is None:
        # Concurrent channels may create the same release. Re-read after the
        # attempt, then require the same commit before adding any assets.
        with tempfile.NamedTemporaryFile(mode="w", suffix=".md") as notes:
            notes.write(
                "Artifacts are added per channel after its checks and applicable signing pass. "
                "For macOS, read MACOS-RELEASE.txt for the signing/notarization status and first-launch instructions. "
                "Homebrew preserves quarantine; unsigned mode has no Developer ID or Apple notarization. "
                "Only listed assets are available. Linux desktop packages are experimental. Windows is unsupported.\n"
            )
            notes.flush()
            result = subprocess.run(
                [
                    "gh",
                    "release",
                    "create",
                    tag,
                    "--repo",
                    repository,
                    "--verify-tag",
                    "--target",
                    sha,
                    "--draft",
                    "--generate-notes",
                    "--notes-file",
                    notes.name,
                ],
                capture_output=True,
                text=True,
            )
        release = get_release()
        if release is None:
            raise RuntimeError("Unable to create release: " + result.stderr)
    # target_commitish is only a tag-creation hint and may name the default
    # branch even for an existing stable tag. Recheck the canonical tag instead.
    current_sha = subprocess.check_output(
        ["gh", "api", f"repos/{repository}/commits/refs/tags/{tag}", "--jq", ".sha"], text=True
    ).strip()
    if current_sha != sha:
        raise ValueError("Release tag moved before asset upload")
    # Establish all existing digests before the first upload; never clobber.
    missing = [path for path in assets if not identical(path, release)]
    for path in missing:
        result = subprocess.run(
            ["gh", "release", "upload", tag, "--repo", repository, str(path)],
            capture_output=True,
            text=True,
        )
        if result.returncode:
            # Another qualified channel may have added the identical shared CLI
            # asset while this one was running. A different digest still fails.
            latest = get_release()
            if latest is None or not identical(path, latest):
                raise RuntimeError("Unable to upload channel asset: " + result.stderr)
    latest = get_release()
    if latest is None:
        raise RuntimeError("Release disappeared before channel completion")
    if latest["draft"]:
        subprocess.run(
            ["gh", "release", "edit", tag, "--repo", repository, "--draft=false"], check=True
        )
    print(f"Published {channel} assets for {tag}")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("version")
    parser.add_argument("output", type=Path)
    parser.add_argument("--channel", required=True, choices=["server", "desktop", "macos"])
    parser.add_argument("--macos-mode", choices=["unsigned", "signed"])
    args = parser.parse_args()
    publish(args.version, args.output.resolve(), args.channel, args.macos_mode)
