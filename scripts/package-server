#!/usr/bin/env python3
"""Build a versioned CLI archive using the platform packaging implementation."""

import argparse
import os
from pathlib import Path
import subprocess
import sys

from release_contract import ROOT, version_number, write_checksum

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument(
    "--platform", required=True, choices=["darwin-arm64", "linux-amd64", "linux-arm64"]
)
parser.add_argument("--output", required=True, type=Path)
args = parser.parse_args()
version = version_number(os.environ["POT_APP_VERSION"])
subprocess.run(
    [
        sys.executable,
        str(ROOT / "scripts/build-pot-cli"),
        "--platform",
        args.platform,
        "--output",
        str(args.output),
    ],
    check=True,
)
original = args.output / f"pot-{args.platform}.tar.gz"
archive = args.output / f"pot-{version}-{args.platform}.tar.gz"
original.replace(archive)
original.with_name(original.name + ".sha256").unlink()
write_checksum(archive)
print(archive)
