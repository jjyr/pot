#!/usr/bin/env python3
"""Explicitly refresh the offline model directory seed; never run during builds."""

from concurrent.futures import ThreadPoolExecutor
import json
from pathlib import Path
import subprocess

ROOT = Path(__file__).resolve().parents[1]
DESTINATION = ROOT / "resources/model-directory.json"
FIELDS = ("name", "limit", "modalities", "tool_call", "provider", "status", "type")
LOGOS = (
    "openai",
    "anthropic",
    "google",
    "deepseek",
    "openrouter",
    "opencode",
    "opencode-go",
    "mistral",
    "cerebras",
    "deepinfra",
    "xai",
    "moonshotai",
    "togetherai",
    "zhipuai",
)


def download(url):
    return subprocess.run(
        ["curl", "--fail", "--silent", "--show-error", "--max-time", "30", url],
        check=True,
        capture_output=True,
    ).stdout.decode()


def logo(provider):
    try:
        return provider, download(f"https://models.dev/logos/{provider}.svg")
    except subprocess.CalledProcessError:
        return provider, None


def main():
    upstream = json.loads(download("https://models.dev/api.json?type=all"))
    if not isinstance(upstream, dict) or not upstream:
        raise SystemExit("Invalid model directory")
    providers = {
        provider: {
            "name": data["name"],
            "npm": data["npm"],
            "api": data.get("api"),
            "doc": data.get("doc"),
            "models": {
                model_id: {key: model[key] for key in FIELDS if key in model}
                for model_id, model in data["models"].items()
            },
        }
        for provider, data in upstream.items()
    }
    previous = json.loads(DESTINATION.read_text()) if DESTINATION.exists() else {}
    logos = previous.get("logos", {})
    with ThreadPoolExecutor(max_workers=8) as pool:
        logos.update({key: value for key, value in pool.map(logo, LOGOS) if value})
    snapshot = {"providers": providers, "logos": logos, "etag": None}
    temporary = DESTINATION.with_suffix(".tmp")
    temporary.write_text(json.dumps(snapshot, ensure_ascii=False, separators=(",", ":")) + "\n")
    temporary.replace(DESTINATION)
    print(f"Updated {len(providers)} providers and {len(logos)} logos")


if __name__ == "__main__":
    main()
