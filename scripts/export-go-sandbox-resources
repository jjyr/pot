#!/usr/bin/env python3
"""Export deterministic Go guest resources against the embedded JSON trust root."""

import argparse
import gzip
import hashlib
import json
from pathlib import Path
import shutil
import tarfile

from go_packaging import BUILD, ROOT, digest


def export(source, output, tag, catalog_path, update):
    output.mkdir(parents=True, exist_ok=True)
    metadata = json.loads((source / "sandbox-image.json").read_text())
    entries = {}
    for kind, path in (
        ("kernel", source / "vmlinux"),
        ("boot", source / "init-image"),
        ("image", source / "sandbox-image"),
    ):
        if path.is_symlink():
            raise ValueError(f"Symlink source: {path}")
        directory = path.is_dir()
        target = output / f".linux-arm64-{kind}.export"
        total = 0
        if directory:
            with (
                target.open("wb") as raw,
                gzip.GzipFile(filename="", mode="wb", fileobj=raw, mtime=0) as compressed,
                tarfile.open(fileobj=compressed, mode="w", format=tarfile.USTAR_FORMAT) as archive,
            ):
                for item in sorted(path.rglob("*")):
                    if item.is_symlink() or not (item.is_file() or item.is_dir()):
                        raise ValueError(f"Unsafe export source: {item}")
                    if item.is_file():
                        info = tarfile.TarInfo(item.relative_to(path).as_posix())
                        info.size, info.mode = item.stat().st_size, 0o644
                        total += info.size
                        with item.open("rb") as data:
                            archive.addfile(info, data)
        else:
            shutil.copyfile(path, target)
            total = target.stat().st_size
        checksum = digest(target)
        filename = f"linux-arm64-{kind}-{checksum[:16]}" + (".tar.gz" if directory else "")
        named = output / filename
        target.replace(named)
        entries[f"{kind}-{checksum[:16]}"] = {
            "release_tag": tag,
            "filename": filename,
            "sha256": checksum,
            "size_bytes": named.stat().st_size,
            "unpacked_bytes": total,
            "format": "oci-tar-gzip" if directory else "raw",
        }
    old = (
        json.loads(catalog_path.read_text())
        if catalog_path.exists()
        else {"schema_version": 1, "resources": {}, "bundles": {}}
    )
    if update:
        for key, value in entries.items():
            if key in old["resources"] and any(
                old["resources"][key][field] != entry
                for field, entry in value.items()
                if field != "release_tag"
            ):
                raise ValueError("Immutable resource identity collision")
            old["resources"].setdefault(key, value)
        keys = list(entries)
        bundle = {
            "kernel": keys[0],
            "boot": keys[1],
            "image": keys[2],
            "image_reference": metadata["reference"],
            "boot_reference": "ghcr.io/apple/containerization/vminit@sha256:4c1836052eafcbc944c403fb23ded06562962d2402c9dcc651495a32300614df",
            "bootstrap_version": "pot-executor-v2",
            "os": "linux",
            "architecture": "arm64",
        }
        identity = hashlib.sha256(
            json.dumps(bundle, sort_keys=True, separators=(",", ":")).encode()
        ).hexdigest()[:16]
        name = next(
            (key for key, value in old["bundles"].items() if value == bundle),
            "linux-arm64-" + identity,
        )
        old["bundles"].setdefault(name, bundle)
        old["default_linux_bundle"] = name
        catalog_path.parent.mkdir(parents=True, exist_ok=True)
        catalog_path.write_text(json.dumps(old, indent=2) + "\n")
    else:
        for key, value in entries.items():
            expected = old["resources"].get(key)
            if expected is None or any(
                expected[field] != entry for field, entry in value.items() if field != "release_tag"
            ):
                raise ValueError(
                    "Resources differ from embedded Go catalog; explicitly export --update-catalog then rebuild clients"
                )
            if expected["release_tag"] != tag:
                (output / value["filename"]).unlink()
    print(json.dumps({"output": str(output), "resources": entries}, indent=2))


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--source", type=Path, default=BUILD / "resources")
    parser.add_argument("--output", type=Path, default=BUILD / "releases/resources")
    parser.add_argument("--tag", default="sandbox-go-resources-v0.1.0")
    parser.add_argument("--catalog", type=Path, default=ROOT / "resources/sandbox/catalog.json")
    parser.add_argument("--update-catalog", action="store_true")
    args = parser.parse_args()
    export(args.source, args.output, args.tag, args.catalog, args.update_catalog)
