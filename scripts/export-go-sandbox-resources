#!/usr/bin/env python3
"""Export exact reviewed OCI bytes against the embedded JSON trust root."""

import argparse
import gzip
import hashlib
import json
from pathlib import Path
import platform
import re
import tarfile
import tempfile

from go_packaging import BUILD, ROOT, digest, oci_image_descriptor


def validate_image_reference(layout, reference, manifest_digest):
    """Bind the metadata reference to its leaf manifest as the Runtime does."""
    index = json.loads((layout / "index.json").read_text())

    def contains_manifest(descriptor):
        if descriptor["digest"] == manifest_digest:
            return True
        value = json.loads(
            (layout / "blobs/sha256" / descriptor["digest"].split(":", 1)[1]).read_bytes()
        )
        return any(contains_manifest(child) for child in value.get("manifests", []))

    if not any(
        descriptor.get("annotations", {}).get("org.opencontainers.image.ref.name") == reference
        and contains_manifest(descriptor)
        for descriptor in index["manifests"]
    ):
        raise ValueError("Guest image reference does not select the reviewed OCI manifest")


def export(source, output, tag, catalog_path, update, architecture=None):
    source, output, catalog_path = Path(source), Path(output), Path(catalog_path)
    metadata = json.loads((source / "sandbox-image.json").read_text())
    architecture = architecture or metadata.get("architecture")
    if (
        metadata.get("schema_version") != 1
        or metadata.get("os") != "linux"
        or architecture not in {"arm64", "amd64"}
        or metadata.get("architecture") != architecture
        or not isinstance(metadata.get("reference"), str)
        or not re.fullmatch(r"[a-z0-9][a-z0-9._:/@-]{0,250}", metadata["reference"])
        or not re.fullmatch(r"sandbox-go-resources-v\d+\.\d+\.\d+", tag)
    ):
        raise ValueError("Invalid guest image metadata, architecture or release tag")
    layout = source / "sandbox-image"
    descriptor, _ = oci_image_descriptor(layout, architecture)
    if descriptor["digest"] != metadata.get("manifest_digest"):
        raise ValueError("Guest metadata does not match the reviewed OCI manifest")
    validate_image_reference(layout, metadata["reference"], metadata["manifest_digest"])
    old = (
        json.loads(catalog_path.read_text())
        if catalog_path.exists()
        else {"schema_version": 2, "default_linux_bundles": {}, "resources": {}, "bundles": {}}
    )
    if old.get("schema_version") != 2:
        raise ValueError("A schema 2 resource catalog is required")
    output.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix=".resource-export-", dir=output) as temporary:
        target = Path(temporary) / "image.tar.gz"
        total = 0
        with (
            target.open("wb") as raw,
            gzip.GzipFile(filename="", mode="wb", fileobj=raw, mtime=0) as compressed,
            tarfile.open(fileobj=compressed, mode="w", format=tarfile.USTAR_FORMAT) as archive,
        ):
            for item in sorted(layout.rglob("*")):
                if item.is_symlink() or not (item.is_file() or item.is_dir()):
                    raise ValueError(f"Unsafe export source: {item}")
                if item.is_file():
                    info = tarfile.TarInfo(item.relative_to(layout).as_posix())
                    info.size, info.mode = item.stat().st_size, 0o644
                    total += info.size
                    with item.open("rb") as data:
                        archive.addfile(info, data)
        checksum = digest(target)
        key = "image-" + checksum[:16]
        filename = f"linux-{architecture}-image-{checksum[:16]}.tar.gz"
        entry = {
            "release_tag": tag,
            "filename": filename,
            "sha256": checksum,
            "size_bytes": target.stat().st_size,
            "unpacked_bytes": total,
            "format": "oci-tar-gzip",
        }
        bundle = {
            "image": key,
            "image_reference": metadata["reference"],
            "manifest_digest": metadata["manifest_digest"],
            "bootstrap_version": "pot-executor-v2",
            "os": "linux",
            "architecture": architecture,
        }
        identity = hashlib.sha256(
            json.dumps(bundle, sort_keys=True, separators=(",", ":")).encode()
        ).hexdigest()[:16]
        name = f"linux-{architecture}-" + identity
        expected = old["resources"].get(key)
        if expected is not None and expected != entry:
            raise ValueError("Immutable resource identity collision")
        if update:
            old["resources"].setdefault(key, entry)
            if name in old["bundles"] and old["bundles"][name] != bundle:
                raise ValueError("Immutable bundle identity collision")
            old["bundles"].setdefault(name, bundle)
            old["default_linux_bundles"][architecture] = name
        elif (
            expected != entry
            or old["bundles"].get(name) != bundle
            or old["default_linux_bundles"].get(architecture) != name
        ):
            raise ValueError(
                "Resources differ from embedded Go catalog; explicitly export --update-catalog then rebuild clients"
            )
        target.replace(output / filename)
        if update:
            catalog_path.parent.mkdir(parents=True, exist_ok=True)
            catalog_path.write_text(json.dumps(old, indent=2) + "\n")
    result = {"output": str(output), "resources": {key: entry}, "bundle": name}
    print(json.dumps(result, indent=2))
    return result


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--arch",
        choices=["arm64", "amd64"],
        default={"x86_64": "amd64", "aarch64": "arm64", "arm64": "arm64"}.get(platform.machine()),
    )
    parser.add_argument(
        "--source", type=Path, help="Reviewed image directory; default .local/go/images/linux-ARCH"
    )
    parser.add_argument("--output", type=Path, default=BUILD / "releases/resources")
    parser.add_argument("--tag", default="sandbox-go-resources-v0.3.0")
    parser.add_argument("--catalog", type=Path, default=ROOT / "resources/sandbox/catalog.json")
    parser.add_argument("--update-catalog", action="store_true")
    args = parser.parse_args()
    if not args.arch:
        parser.error("Specify --arch for this host")
    export(
        args.source or BUILD / "images" / ("linux-" + args.arch),
        args.output,
        args.tag,
        args.catalog,
        args.update_catalog,
        args.arch,
    )
