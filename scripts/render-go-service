#!/usr/bin/env python3
"""Render a reviewable user-systemd unit; never install or enable a service."""

import argparse
from pathlib import Path

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--binary", type=Path, required=True)
parser.add_argument("--root", type=Path, default=Path.home() / ".pot-go")
parser.add_argument("--output", type=Path, required=True)
parser.add_argument(
    "--template", action="store_true", help="Use @POT_GO_PREFIX@ for the installation prefix"
)
args = parser.parse_args()
for value in (str(args.binary), str(args.root)):
    if any(char in value for char in '\n\r"\\'):
        parser.error("Service paths contain unsupported characters")
binary = "@POT_GO_PREFIX@/bin/pot" if args.template else str(args.binary.resolve(strict=True))
root = "%h/.pot-go" if args.template else str(args.root.resolve())
working = "@POT_GO_PREFIX@" if args.template else str(args.binary.resolve().parent.parent)
args.output.parent.mkdir(parents=True, exist_ok=True)
args.output.write_text(f'''# Review paths and install explicitly as a user unit named pot-go-runtime.service.
# This file does not replace any existing Pot service or read its data directory.
[Unit]
Description=Pot Go Runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory="{working}"
ExecStart="{binary}" serve -root "{root}"
EnvironmentFile=-%h/.config/pot-go/runtime.env
UMask=0077
Restart=on-failure
RestartSec=3
TimeoutStopSec=45
KillMode=mixed

[Install]
WantedBy=default.target
''')
print(args.output.resolve())
