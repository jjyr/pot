#!/usr/bin/env python3
"""Propose a same-repository cask update from an already published macOS ZIP."""

import argparse
import base64
import json
import os
from pathlib import Path
import re
import subprocess
import tempfile
from urllib.parse import quote

from release_contract import checksum, generate_cask, version_number


def api(repository, endpoint, data=None, missing=False):
    command = ["gh", "api", f"repos/{repository}/{endpoint}".rstrip("/")]
    if data is not None:
        command += ["--method", "POST", "--input", "-"]
    result = subprocess.run(
        command,
        input=json.dumps(data) if data is not None else None,
        capture_output=True,
        text=True,
    )
    if result.returncode:
        if missing and result.stdout:
            error = json.loads(result.stdout)
            if str(error.get("status")) == "404":
                return None
        raise RuntimeError(f"GitHub {endpoint}: {result.stderr.strip()}")
    return json.loads(result.stdout)


def propose(repository, version, cask):
    """Create a branch once. Never update an existing branch, PR, or default ref."""
    base = api(repository, "")["default_branch"]
    base_sha = api(repository, f"commits/{quote(base, safe='')}")["sha"]
    current = api(repository, f"contents/Casks/pot.rb?ref={base_sha}")
    current_text = base64.b64decode(current["content"]).decode()
    if current_text == cask:
        return "Cask already synchronized on the default branch."
    current_version = re.search(r'^  version "([0-9.]+)"$', current_text, re.M)
    if current_version and tuple(map(int, current_version[1].split("."))) >= tuple(
        map(int, version.split("."))
    ):
        raise ValueError("Refusing to replace an equal or newer default-branch cask")
    branch = f"homebrew/pot-v{version}"
    prs = api(
        repository,
        f"pulls?state=all&head={quote(repository.split('/')[0] + ':' + branch, safe='')}&per_page=100",
    )
    for pr in prs:
        if pr["base"]["ref"] != base:
            raise ValueError("Existing cask PR targets a different base; review it manually")
        if pr["state"] == "closed":
            raise ValueError("Cask PR was closed or merged; review default-branch state manually")
    existing = api(repository, f"git/ref/heads/{branch}", missing=True)
    if existing:
        content = api(repository, f"contents/Casks/pot.rb?ref={existing['object']['sha']}")
        if base64.b64decode(content["content"]).decode() != cask:
            raise ValueError("Existing cask branch differs; refusing to rewrite it")
        comparison = api(repository, f"compare/{base_sha}...{existing['object']['sha']}")
        if [f["filename"] for f in comparison["files"]] != ["Casks/pot.rb"]:
            raise ValueError("Existing branch contains other changes; review it manually")
    else:
        commit = api(repository, f"git/commits/{base_sha}")
        tree = api(
            repository,
            "git/trees",
            {
                "base_tree": commit["tree"]["sha"],
                "tree": [
                    {"path": "Casks/pot.rb", "mode": "100644", "type": "blob", "content": cask}
                ],
            },
        )
        commit = api(
            repository,
            "git/commits",
            {
                "message": f"Update Homebrew cask to Pot {version}",
                "tree": tree["sha"],
                "parents": [base_sha],
            },
        )
        api(repository, "git/refs", {"ref": "refs/heads/" + branch, "sha": commit["sha"]})
    if prs:
        return "Existing cask PR: " + prs[0]["html_url"]
    print(f"Verified cask branch: https://github.com/{repository}/tree/{branch}")
    pr = api(
        repository,
        "pulls",
        {
            "title": f"Update Homebrew cask to Pot {version}",
            "head": branch,
            "base": base,
            "body": (
                f"Install Pot {version} from the published macOS App ZIP. The shared cask generator "
                "verified its bundle version, checksum sidecar and GitHub asset digest against the downloaded final bytes.\n\n"
                "This changes only Casks/pot.rb. Merge after review to enable Homebrew installation/upgrades; "
                "the release tag and assets remain immutable. Homebrew preserves quarantine."
            ),
        },
    )
    return "Created cask PR: " + pr["html_url"]


def sync(version, revision, repository):
    version = version_number(version)
    if repository != "jjyr/pot" or not re.fullmatch(r"[a-f0-9]{40}", revision):
        raise ValueError("Expected jjyr/pot and a validated full release SHA")
    tag = "v" + version
    if api(repository, f"commits/refs/tags/{tag}")["sha"] != revision:
        raise ValueError("Release tag moved after validation")
    release = api(repository, f"releases/tags/{tag}")
    if release["draft"] or release["prerelease"]:
        raise ValueError("Cask sync requires a published stable release")
    name = f"Pot-{version}-arm64.zip"
    asset = next((a for a in release["assets"] if a["name"] == name), None)
    if asset is None:
        raise ValueError("Published release is missing the final macOS App ZIP")
    with tempfile.TemporaryDirectory(prefix="pot-cask-") as temporary:
        output = Path(temporary)
        subprocess.run(
            [
                "gh",
                "release",
                "download",
                tag,
                "--repo",
                repository,
                "--pattern",
                name,
                "--pattern",
                name + ".sha256",
                "--dir",
                temporary,
            ],
            check=True,
        )
        archive = output / name
        if (
            asset.get("digest") != "sha256:" + checksum(archive)
            or asset["size"] != archive.stat().st_size
        ):
            raise ValueError("Downloaded ZIP does not match published asset digest/size")
        generate_cask(version, output)
        if api(repository, f"commits/refs/tags/{tag}")["sha"] != revision:
            raise ValueError("Release tag moved before cask proposal")
        return propose(repository, version, (output / "pot.rb").read_text())


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("version")
    parser.add_argument("revision")
    args = parser.parse_args()
    print(sync(args.version, args.revision, os.environ["GITHUB_REPOSITORY"]))


if __name__ == "__main__":
    main()
