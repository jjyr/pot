#!/usr/bin/env python3
"""Build and package the product directories."""

import hashlib, os, pathlib, plistlib, shutil, subprocess, sys

REPO = pathlib.Path(__file__).resolve().parents[1]
ROOT = REPO / ".local/d1"
RES = ROOT / "resources"
APP = ROOT / "Pot.app"
ROOT.mkdir(parents=True, exist_ok=True)
RES.mkdir(exist_ok=True)


def call(args, **kwargs):
    return subprocess.run([str(a) for a in args], check=True, **kwargs)


def verify(path, digest, kind="sha256"):
    if hashlib.new(kind, path.read_bytes()).hexdigest() != digest:
        raise SystemExit("Checksum mismatch: " + str(path))


def download(url, path):
    if not path.exists():
        temp = path.with_suffix(".download")
        call(["curl", "--fail", "--location", "--retry", "2", url, "-o", temp])
        temp.replace(path)


cmd = sys.argv[1] if len(sys.argv) > 1 else "help"
env = dict(os.environ, CARGO_TARGET_DIR=str(REPO / ".local/poc/cargo-target"))
if cmd == "prepare":
    # Reuse verified immutable downloads when available, without depending on POC code.
    for name in ["vmlinux"]:
        cached = REPO / ".local/poc/local-resources" / name
        if not (RES / name).exists() and cached.exists():
            shutil.copy2(cached, RES / name)
    if not (RES / "vmlinux").exists():
        archive = RES / "kata.tar.zst"
        download(
            "https://github.com/kata-containers/kata-containers/releases/download/3.32.0/kata-static-3.32.0-arm64.tar.zst",
            archive,
        )
        verify(archive, "8736c054d9223974735394f822000823baef509e1c33405ec798240fa9b6e4b5")
        with (RES / "vmlinux").open("wb") as out:
            call(
                ["tar", "xOf", archive, "opt/kata/share/kata-containers/vmlinux-6.18.35-197-debug"],
                stdout=out,
            )
    verify(RES / "vmlinux", "fb2cfb79eb1ae19447a85d75682d7fa5cfec97e24beb2609a492b806e8072c8d")
    novnc_archive = RES / "novnc-1.7.0.tar.gz"
    download("https://github.com/novnc/noVNC/archive/refs/tags/v1.7.0.tar.gz", novnc_archive)
    verify(novnc_archive, "b1003a11b6e6e8d8f7f5e5586daae7f8ca651d8aee0aa155ff9ac841c48f52c6")
    shutil.copy2(novnc_archive, RES / "novnc.tar.gz")
    call(["python3", REPO / "scripts/localize-web"])
    for name in [
        "sandbox.sh",
        "executor.py",
        "skill_mounts.py",
        "desktop.sh",
        "desktop-config.sh",
        "desktop-session.sh",
        "pot-wallpaper.svg",
        "packages.lock",
        "test.html",
        "home.html",
        "driver.py",
        "broker.py",
        "index.html",
        "close-browser.py",
        "open-browser.sh",
    ]:
        shutil.copy2(REPO / "image" / name, RES / name)
    node_name = "node-v24.21.0-darwin-arm64"
    node_archive = RES / (node_name + ".tar.gz")
    download("https://nodejs.org/dist/v24.21.0/" + node_archive.name, node_archive)
    sums = RES / "node-SHASUMS256.txt"
    download("https://nodejs.org/dist/v24.21.0/SHASUMS256.txt", sums)
    node_digest = next(
        row.split()[0]
        for row in sums.read_text().splitlines()
        if row.split()[-1] == node_archive.name
    )
    verify(node_archive, node_digest)
    if not (RES / "node/bin/node").exists():
        call(["tar", "xzf", node_archive, "-C", RES])
        (RES / node_name).rename(RES / "node")
    for name in ["package.json", "package-lock.json"]:
        shutil.copy2(REPO / "image/agents" / name, RES / ("agents-" + name))
elif cmd == "build":
    call([sys.executable, REPO / "scripts/build-mobile"], cwd=REPO, env=env)
    call(
        ["cargo", "build", "--locked", "-p", "pot-app", "-p", "pot-server", "-j", "4"],
        cwd=REPO,
        env=env,
    )
    call(
        [
            "swift",
            "build",
            "-c",
            "release",
            "--package-path",
            REPO / "helper",
            "--disable-sandbox",
            "--scratch-path",
            ROOT / "helper-build",
            "--force-resolved-versions",
            "-j",
            "4",
        ],
        env=dict(
            os.environ,
            SWIFTPM_MODULECACHE_OVERRIDE=str(ROOT / "swift-modules"),
            CLANG_MODULE_CACHE_PATH=str(ROOT / "clang-modules"),
        ),
    )
elif cmd == "bundle":
    for sub in ["MacOS", "Helpers", "Resources/runtime"]:
        (APP / "Contents" / sub).mkdir(parents=True, exist_ok=True)
    # Remove obsolete xterm resources from an existing development bundle.
    obsolete_terminal = APP / "Contents/Resources/terminal"
    if obsolete_terminal.exists():
        shutil.rmtree(obsolete_terminal)
    for src, dest in [
        (pathlib.Path(env["CARGO_TARGET_DIR"]) / "debug/pot-app", APP / "Contents/MacOS/pot-app"),
        (ROOT / "helper-build/release/PotHelper", APP / "Contents/Helpers/PotHelper"),
    ]:
        tmp = dest.with_suffix(".new")
        shutil.copy2(src, tmp)
        tmp.replace(dest)
    call(
        [
            "cargo",
            "zigbuild",
            "--locked",
            "--release",
            "--target",
            "aarch64-unknown-linux-musl",
            "-p",
            "pot-tool-executor",
            "-j",
            "4",
        ],
        cwd=REPO,
        env=env,
    )
    shutil.copy2(
        pathlib.Path(env["CARGO_TARGET_DIR"])
        / "aarch64-unknown-linux-musl/release/pot-tool-executor",
        RES / "pot-tool-executor",
    )
    call([REPO / "scripts/build-image"])
    shutil.rmtree(APP / "Contents/Resources/runtime")
    (APP / "Contents/Resources/runtime").mkdir()
    for name in ["sandbox-image", "init-image"]:
        dest = APP / "Contents/Resources/runtime" / name
        if dest.exists():
            shutil.rmtree(dest)
        shutil.copytree(RES / name, dest)
    shutil.copy2(RES / "sandbox-image.json", APP / "Contents/Resources/runtime/sandbox-image.json")
    shutil.copytree(RES / "node", APP / "Contents/Resources/runtime/node")
    for name in ["vmlinux"]:
        shutil.copy2(RES / name, APP / "Contents/Resources/runtime" / name)
    for name in ["pot-server", "pot-access"]:
        shutil.copy2(
            pathlib.Path(env["CARGO_TARGET_DIR"]) / "debug" / name,
            APP / "Contents/Resources/runtime" / name,
        )
    shutil.copytree(REPO / "mobile/dist", APP / "Contents/Resources/runtime/mobile")
    shutil.copytree(
        REPO / "skills",
        APP / "Contents/Resources/runtime/skills",
        ignore=shutil.ignore_patterns("__pycache__", "*.pyc"),
    )
    host_tools = APP / "Contents/Resources/runtime/host-tools"
    host_tools.mkdir(exist_ok=True)
    shutil.copy2(REPO / "image/agents/package.json", host_tools / "package.json")
    shutil.copy2(REPO / "image/agents/package-lock.json", host_tools / "package-lock.json")
    call(
        [
            RES / "node/bin/node",
            RES / "node/lib/node_modules/npm/bin/npm-cli.js",
            "ci",
            "--cache",
            ROOT / "npm-cache",
            "--prefix",
            host_tools,
            "--ignore-scripts",
            "--omit=dev",
            "--no-audit",
            "--no-fund",
        ]
    )
    for name in ["Pot.icns", "PotTray.png"]:
        shutil.copy2(REPO / "app/assets" / name, APP / "Contents/Resources" / name)
    (APP / "Contents/Info.plist").write_bytes(
        plistlib.dumps(
            dict(
                CFBundleIdentifier="dev.pot.app",
                CFBundleName="Pot",
                CFBundleLocalizations=["en", "zh_CN"],
                CFBundleDevelopmentRegion="en",
                CFBundleDisplayName="Pot",
                CFBundleIconFile="Pot.icns",
                CFBundleExecutable="pot-app",
                CFBundlePackageType="APPL",
                CFBundleVersion="1",
                NSHighResolutionCapable=True,
                NSAppTransportSecurity={"NSAllowsLocalNetworking": True},
            )
        )
    )
    call(
        [
            "codesign",
            "--force",
            "--sign",
            "-",
            "--entitlements",
            REPO / "helper/virtualization.entitlements",
            APP / "Contents/Helpers/PotHelper",
        ]
    )
    call(["codesign", "--force", "--sign", "-", APP])
    call(["codesign", "--verify", "--deep", "--strict", APP])
    print(APP)
elif cmd == "open":
    call(
        [
            "open",
            "--env",
            "POT_LOCAL_ROOT=" + os.environ.get("POT_LOCAL_ROOT", str(ROOT / "local-runtime")),
            APP,
        ]
    )
else:
    print("Usage: scripts/pot prepare|build|bundle|open")
