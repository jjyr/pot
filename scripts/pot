#!/usr/bin/env python3
"""Build and package the product directories."""
import hashlib, os, pathlib, plistlib, shutil, subprocess, sys
REPO=pathlib.Path(__file__).resolve().parents[1]
ROOT=REPO/'.local/d1'; RES=ROOT/'resources'; APP=ROOT/'Pot.app'
ROOT.mkdir(parents=True,exist_ok=True); RES.mkdir(exist_ok=True)
def call(args,**kwargs): return subprocess.run([str(a) for a in args],check=True,**kwargs)
def verify(path,digest,kind='sha256'):
 if hashlib.new(kind,path.read_bytes()).hexdigest()!=digest: raise SystemExit('Checksum mismatch: '+str(path))
def download(url,path):
 if not path.exists():
  temp=path.with_suffix('.download');call(['curl','--fail','--location','--retry','2',url,'-o',temp]);temp.replace(path)
cmd=sys.argv[1] if len(sys.argv)>1 else 'help'
env=dict(os.environ,CARGO_TARGET_DIR=str(REPO/'.local/poc/cargo-target'))
if cmd=='prepare':
 # Reuse verified immutable downloads when available, without depending on POC code.
 for name in ['vmlinux','novnc.tar.gz']:
  cached=REPO/'.local/poc/local-resources'/name
  if not (RES/name).exists() and cached.exists():shutil.copy2(cached,RES/name)
 if not (RES/'vmlinux').exists():
  archive=RES/'kata.tar.zst';download('https://github.com/kata-containers/kata-containers/releases/download/3.32.0/kata-static-3.32.0-arm64.tar.zst',archive)
  verify(archive,'8736c054d9223974735394f822000823baef509e1c33405ec798240fa9b6e4b5')
  with (RES/'vmlinux').open('wb') as out:call(['tar','xOf',archive,'opt/kata/share/kata-containers/vmlinux-6.18.35-197-debug'],stdout=out)
 verify(RES/'vmlinux','fb2cfb79eb1ae19447a85d75682d7fa5cfec97e24beb2609a492b806e8072c8d')
 download('https://github.com/novnc/noVNC/archive/refs/tags/v1.6.0.tar.gz',RES/'novnc.tar.gz')
 verify(RES/'novnc.tar.gz','5066103959ef4e9b10f37e5a148627360dd8414e4cf8a7db92bdbd022e728aaa')
 download('https://storage.googleapis.com/antigravity-public/antigravity-cli/1.2.16-5594158052802560/linux-arm-musl/cli_linux_arm64_musl.tar.gz',RES/'agy-musl.tar.gz')
 verify(RES/'agy-musl.tar.gz','3f5ef952365b58c358ed79e0bb61768b17afdfd8fd00ccfd39b06f50789c8c0069890cf88583e0edfa194c1ddd9640211f02a8daac58a41f9bd73bac786e414c','sha512')
 call(['tar','xzf',RES/'agy-musl.tar.gz','-C',RES])
 shutil.copy2(RES/'antigravity',RES/'agy')
 for name in ['desktop.sh','desktop-config.sh','desktop-session.sh','pot-wallpaper.svg','packages.lock','test.html','home.html','driver.py','broker.py','index.html','close-browser.py','open-browser.sh']:shutil.copy2(REPO/'image'/name,RES/name)
 for name in ['package.json','package-lock.json']:shutil.copy2(REPO/'image/pi'/name,RES/('pi-'+name))
elif cmd=='build':
 call(['cargo','build','--locked','-p','pot-app','-j','4'],cwd=REPO,env=env)
 call(['cargo','zigbuild','--locked','-p','pot-runtime','--target','aarch64-unknown-linux-musl','-j','4'],cwd=REPO,env=env)
 call(['swift','build','-c','release','--package-path',REPO/'helper','--disable-sandbox','--scratch-path',ROOT/'helper-build','--force-resolved-versions','-j','4'],env=dict(os.environ,SWIFTPM_MODULECACHE_OVERRIDE=str(ROOT/'swift-modules'),CLANG_MODULE_CACHE_PATH=str(ROOT/'clang-modules')))
elif cmd=='bundle':
 legacy=ROOT/'pot.app'
 if legacy.exists() and (not APP.exists() or legacy.samefile(APP)):legacy.rename(APP)
 for sub in ['MacOS','Helpers','Resources/runtime']:(APP/'Contents'/sub).mkdir(parents=True,exist_ok=True)
 for src,dest in [(pathlib.Path(env['CARGO_TARGET_DIR'])/'debug/pot-app',APP/'Contents/MacOS/pot-app'),(ROOT/'helper-build/release/PotHelper',APP/'Contents/Helpers/PotHelper')]:
  tmp=dest.with_suffix('.new');shutil.copy2(src,tmp);tmp.replace(dest)
 shutil.copy2(pathlib.Path(env['CARGO_TARGET_DIR'])/'aarch64-unknown-linux-musl/debug/pot-runtime',RES/'pot-runtime')
 call([REPO/'scripts/build-image'])
 shutil.rmtree(APP/'Contents/Resources/runtime')
 (APP/'Contents/Resources/runtime').mkdir()
 for name in ['sandbox-image','init-image']:
  dest=APP/'Contents/Resources/runtime'/name
  if dest.exists():shutil.rmtree(dest)
  shutil.copytree(RES/name,dest)
 shutil.copy2(RES/'sandbox-image.json',APP/'Contents/Resources/runtime/sandbox-image.json')
 for name in ['vmlinux']:shutil.copy2(RES/name,APP/'Contents/Resources/runtime'/name)
 for name in ['Pot.icns','PotTray.png']:shutil.copy2(REPO/'app/assets'/name,APP/'Contents/Resources'/name)
 (APP/'Contents/Info.plist').write_bytes(plistlib.dumps(dict(CFBundleIdentifier='dev.pot.app',CFBundleName='Pot',CFBundleDisplayName='Pot',CFBundleIconFile='Pot.icns',CFBundleExecutable='pot-app',CFBundlePackageType='APPL',CFBundleVersion='1',NSHighResolutionCapable=True,NSAppTransportSecurity={'NSAllowsLocalNetworking':True})))
 call(['codesign','--force','--sign','-','--entitlements',REPO/'helper/virtualization.entitlements',APP/'Contents/Helpers/PotHelper'])
 call(['codesign','--force','--sign','-',APP]);call(['codesign','--verify','--deep','--strict',APP]);print(APP)
elif cmd=='open':call(['open','--env','POT_LOCAL_ROOT='+os.environ.get('POT_LOCAL_ROOT',str(ROOT/'local-runtime')),APP])
else:print('Usage: scripts/pot prepare|build|bundle|open')
