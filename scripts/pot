#!/usr/bin/env python3
"""Run the Go/Wails product build and its retained runtime asset preparation."""

import argparse
import subprocess
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("command", choices=["prepare", "build", "bundle", "open"])
args = parser.parse_args()
if args.command == "prepare":
    subprocess.run(["python3", ROOT / "scripts/prepare-go-resources"], cwd=ROOT, check=True)
elif args.command in {"build", "bundle"}:
    subprocess.run(["python3", ROOT / "scripts/build-go-app"], cwd=ROOT, check=True)
else:
    bundle = ROOT / ".local/go/PotGoPreview.app"
    if not bundle.is_dir():
        parser.error("Build the app with mise run build first")
    subprocess.run(["open", bundle], check=True)
