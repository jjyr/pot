#!/usr/bin/env python3
"""Seal validated macOS archives in explicit ad-hoc or Developer ID/notarized mode."""

import argparse
import base64
import os
from pathlib import Path
import plistlib
import secrets
import subprocess
import tarfile
import tempfile

from macos_release import macho_files
from release_contract import ROOT, checksum, version_number, write_checksum


def call(*args):
    result = subprocess.run(args)
    if result.returncode:
        # Certificate/notary passwords must never appear in an exception's argv.
        raise SystemExit(f"{args[0]} failed with status {result.returncode}")


def sign_tree(root, identity, keychain=None):
    options = (
        ["--timestamp=none"]
        if identity == "-"
        else [
            "--timestamp",
            "--options",
            "runtime",
            "--keychain",
            str(keychain),
        ]
    )
    file_options = (
        options
        if identity == "-"
        else [
            *options,
            "--entitlements",
            str(ROOT / "packaging/macos-release.entitlements"),
        ]
    )
    files = list(macho_files(root))
    if not files:
        raise ValueError("macOS archive contains no Mach-O executables")
    for path in files:
        call("codesign", "--force", *file_options, "--sign", identity, str(path))
        call("codesign", "--verify", "--strict", str(path))
    if root.suffix == ".app":
        call("codesign", "--force", *options, "--sign", identity, str(root))
        call("codesign", "--verify", "--deep", "--strict", str(root))


def seal_archives(version, output, root, identity, keychain=None):
    for name in [f"Pot-{version}-arm64.zip", f"pot-go-{version}-darwin-arm64.tar.gz"]:
        archive = output / name
        if archive.with_name(name + ".sha256").read_text() != f"{checksum(archive)}  {name}\n":
            raise ValueError(f"input checksum mismatch: {name}")
        stage = root / name
        stage.mkdir()
        if name.endswith(".zip"):
            call("ditto", "-x", "-k", str(archive), str(stage))
            tree = stage / "Pot.app"
        else:
            with tarfile.open(archive) as packed:
                packed.extractall(stage, filter="data")
            tree = stage / "pot-go-darwin-arm64"
        sign_tree(tree, identity, keychain)
        if identity != "-":
            notary_zip = root / "notary.zip"
            call("ditto", "-c", "-k", "--keepParent", str(tree), str(notary_zip))
            notarize(notary_zip)
            notary_zip.unlink()
            if tree.suffix == ".app":
                call("xcrun", "stapler", "staple", str(tree))
                call("xcrun", "stapler", "validate", str(tree))
                call("spctl", "--assess", "--type", "execute", "--verbose", str(tree))
        if tree.suffix == ".app":
            archive.unlink()
            call("ditto", "-c", "-k", "--sequesterRsrc", "--keepParent", str(tree), str(archive))
        else:
            with tarfile.open(archive, "w:gz") as packed:
                packed.add(tree, arcname=tree.name)
        write_checksum(archive)


def notarize(archive):
    result = subprocess.run(
        [
            "xcrun",
            "notarytool",
            "submit",
            str(archive),
            "--apple-id",
            os.environ["APPLE_ID"],
            "--team-id",
            os.environ["APPLE_TEAM_ID"],
            "--password",
            os.environ["APPLE_APP_PASSWORD"],
            "--wait",
            "--output-format",
            "plist",
        ],
        stdout=subprocess.PIPE,
    )
    if result.returncode or plistlib.loads(result.stdout).get("status") != "Accepted":
        raise RuntimeError("Apple notarization was not accepted")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("version")
    parser.add_argument("output", type=Path)
    parser.add_argument("--mode", required=True, choices=["unsigned", "signed"])
    args = parser.parse_args()
    version = version_number(args.version)
    output = args.output.resolve()
    if args.mode == "unsigned":
        with tempfile.TemporaryDirectory(prefix="pot-adhoc-macos-") as temporary:
            seal_archives(version, output, Path(temporary), "-")
        return
    identity = os.environ["MACOS_SIGNING_IDENTITY"]
    if not identity.startswith("Developer ID Application:"):
        raise ValueError("MACOS_SIGNING_IDENTITY must be a Developer ID Application identity")
    with tempfile.TemporaryDirectory(prefix="pot-sign-macos-") as temporary:
        root = Path(temporary)
        certificate = root / "certificate.p12"
        certificate.write_bytes(
            base64.b64decode(os.environ["MACOS_CERTIFICATE_P12"], validate=True)
        )
        keychain = root / "release.keychain-db"
        password = secrets.token_urlsafe(32)
        call("security", "create-keychain", "-p", password, str(keychain))
        try:
            call("security", "set-keychain-settings", "-lut", "21600", str(keychain))
            call("security", "unlock-keychain", "-p", password, str(keychain))
            call(
                "security",
                "import",
                str(certificate),
                "-k",
                str(keychain),
                "-P",
                os.environ["MACOS_CERTIFICATE_PASSWORD"],
                "-T",
                "/usr/bin/codesign",
            )
            call(
                "security",
                "set-key-partition-list",
                "-S",
                "apple-tool:,apple:",
                "-s",
                "-k",
                password,
                str(keychain),
            )
            seal_archives(version, output, root, identity, keychain)
        finally:
            call("security", "delete-keychain", str(keychain))


if __name__ == "__main__":
    main()
