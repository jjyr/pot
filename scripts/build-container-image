#!/usr/bin/env python3
"""Build the shared Pot OCI rootfs with Podman, without Apple VM tooling."""

import argparse
import hashlib
import os
from pathlib import Path
import platform
import shutil
import subprocess

ROOT = Path(__file__).resolve().parents[1]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument(
    "--arch",
    choices=["amd64", "arm64"],
    default={"x86_64": "amd64", "aarch64": "arm64", "arm64": "arm64"}.get(platform.machine()),
)
parser.add_argument("--tag", default="localhost/pot-sandbox:0.1.0")
parser.add_argument("--executor", type=Path, help="Use an already compiled target musl executor")
args = parser.parse_args()
if args.arch is None:
    parser.error("Specify --arch for this host")
context = ROOT / ".local/container-image" / args.arch
assets = context / "assets"
assets.mkdir(parents=True, exist_ok=True)
recipe = ROOT / "sandbox-images/linux/default"
subprocess.run(["python", ROOT / "scripts/localize-web"], check=True, cwd=ROOT)
for path in recipe.iterdir():
    if path.suffix in {".sh", ".py", ".html", ".svg", ".lock"}:
        shutil.copy2(path, assets / path.name)
if args.executor:
    executor = args.executor.resolve(strict=True)
else:
    target = {"amd64": "x86_64", "arm64": "aarch64"}[args.arch] + "-unknown-linux-musl"
    subprocess.run(
        [
            "cargo",
            "zigbuild",
            "--locked",
            "--release",
            "--target",
            target,
            "-p",
            "pot-tool-executor",
            "-j",
            "4",
        ],
        cwd=ROOT,
        check=True,
    )
    executor = (
        Path(os.environ.get("CARGO_TARGET_DIR", ROOT / "target"))
        / target
        / "release/pot-tool-executor"
    )
shutil.copy2(executor, assets / "pot-tool-executor")
archive = ROOT / ".local/container-image/novnc-1.7.0.tar.gz"
if not archive.exists():
    subprocess.run(
        [
            "curl",
            "--fail",
            "--location",
            "--retry",
            "2",
            "https://github.com/novnc/noVNC/archive/refs/tags/v1.7.0.tar.gz",
            "-o",
            archive,
        ],
        check=True,
    )
if (
    hashlib.sha256(archive.read_bytes()).hexdigest()
    != "b1003a11b6e6e8d8f7f5e5586daae7f8ca651d8aee0aa155ff9ac841c48f52c6"
):
    raise SystemExit("noVNC checksum mismatch")
shutil.copy2(archive, assets / "novnc.tar.gz")
subprocess.run(
    [
        "podman",
        "--remote=false",
        "build",
        "--format=oci",
        "--network=private",
        "--platform=linux/" + args.arch,
        "--file",
        recipe / "Dockerfile",
        "--tag",
        args.tag,
        context,
    ],
    cwd=ROOT,
    check=True,
)
print(f"Built {args.tag} (linux/{args.arch}); Provider pins its local image ID on first prepare")
