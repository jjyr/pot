#!/usr/bin/env python3
"""Build a complete, independently identified Go/Wails development app."""

import os
from pathlib import Path
import platform
import plistlib
import re
import shutil
import tempfile

from go_packaging import BUILD, ROOT, call, go_build, prepare_resources, swift_helpers

if platform.system() != "Darwin" or platform.machine() != "arm64":
    raise SystemExit("The Go desktop targets Apple Silicon macOS.")
version = os.environ.get("POT_APP_VERSION", "0.1.0")
if not re.fullmatch(r"\d+\.\d+\.\d+", version):
    raise SystemExit("POT_APP_VERSION must be major.minor.patch")
BUILD.mkdir(parents=True, exist_ok=True)
helpers = swift_helpers()
bundle = BUILD / "PotGoPreview.app"
with tempfile.TemporaryDirectory(prefix=".go-app-", dir=BUILD) as temporary:
    staged = Path(temporary) / bundle.name
    contents = staged / "Contents"
    binary = contents / "MacOS/pot-app"
    resources = contents / "Resources"
    binary.parent.mkdir(parents=True)
    prepare_resources(resources, "darwin-arm64")
    environment = os.environ.copy()
    environment["MACOSX_DEPLOYMENT_TARGET"] = "26.0"
    for name in ("CGO_CFLAGS", "CGO_LDFLAGS"):
        environment[name] = environment.get(name, "-O2 -g") + " -mmacosx-version-min=26.0"
    call(
        ["go", "build", "-mod=readonly", "-trimpath", "-o", binary, "./cmd/pot-app"],
        env=environment,
    )
    go_build("./cmd/pot", contents / "MacOS/pot", "darwin-arm64")
    for name in ("PotHelper", "PotMacOSHelper"):
        shutil.copy2(helpers / name, contents / "MacOS" / name)
    shutil.copy2(helpers / "SwiftDependencyLicenses.txt", resources / "SwiftDependencyLicenses.txt")
    shutil.copy2(ROOT / "crates/app/assets/Pot.icns", resources / "Pot.icns")
    call(
        [
            "python3",
            ROOT / "scripts/go-notices",
            "--output",
            resources / "GoDependencyLicenses.txt",
            "./cmd/pot-app",
            "./cmd/pot",
            "./cmd/pot-tool-executor",
        ],
        env=environment,
    )
    copyright_notice = next(
        line for line in (ROOT / "LICENSE").read_text().splitlines() if line.startswith("Copyright")
    ).replace("(c)", "©")
    (contents / "Info.plist").write_bytes(
        plistlib.dumps(
            {
                "CFBundleIdentifier": "dev.pot.go-preview",
                "CFBundleName": "Pot Go",
                "CFBundleDisplayName": "Pot Go",
                "CFBundleExecutable": binary.name,
                "CFBundlePackageType": "APPL",
                "CFBundleShortVersionString": version,
                "CFBundleVersion": version,
                "CFBundleIconFile": "Pot.icns",
                "CFBundleDevelopmentRegion": "en",
                "CFBundleLocalizations": ["en", "zh_CN"],
                "LSMinimumSystemVersion": "26.0",
                "NSHighResolutionCapable": True,
                "NSHumanReadableCopyright": copyright_notice,
            }
        )
    )
    for executable in (
        resources / "node/bin/node",
        resources / "macos-bootstrap/pot-tool-executor",
        contents / "MacOS/pot",
        binary,
    ):
        call(["codesign", "--force", "--sign", "-", executable])
    call(["codesign", "--force", "--sign", "-", staged])
    call(["codesign", "--verify", "--deep", "--strict", staged])
    if bundle.exists():
        shutil.rmtree(bundle)
    shutil.move(staged, bundle)
print(bundle)
