#!/usr/bin/env python3
"""Verify one channel's artifacts, checksums and optional macOS signed feed."""

import argparse
import os
from pathlib import Path
import subprocess
import sys

from release_contract import (
    ROOT,
    checksum,
    checksum_name,
    distribution_names,
    generate_cask,
    macos_release_notes,
    version_number,
    verify_oci,
)


def prepare(version, output, sign_feed=False, channel="validation", macos_mode=None):
    version = version_number(version)
    if sign_feed and channel != "macos":
        raise ValueError("only the macOS update channel signs the shared feed")
    if channel == "macos":
        notes = macos_release_notes(version, os.environ.get("POT_BUILD_REVISION"), macos_mode)
        if not sign_feed:
            raise ValueError("macOS publication requires an Ed25519-signed update feed")
    elif macos_mode is not None:
        raise ValueError("macOS mode is only valid for the macOS channel")
    names = distribution_names(version, channel)
    for name in names:
        archive = output / name
        if not archive.is_file() or archive.stat().st_size == 0:
            raise ValueError(f"missing or empty distribution: {name}")
        if archive.with_name(name + ".sha256").read_text() != f"{checksum(archive)}  {name}\n":
            raise ValueError(f"checksum mismatch: {name}")
    if channel in {"container", "validation"}:
        verify_oci(
            output / f"pot-container-{version}.oci.tar",
            version,
            os.environ.get("POT_BUILD_REVISION"),
        )
    if channel in {"macos", "validation"}:
        generate_cask(version, output)
    if sign_feed:
        subprocess.run(
            [sys.executable, str(ROOT / "scripts/update-release"), version, str(output)], check=True
        )
    if channel == "macos":
        (output / "MACOS-RELEASE.txt").write_text(notes)
    files = [output / name for name in names]
    if channel in {"macos", "validation"}:
        files.append(output / "pot.rb")
    if sign_feed:
        files.extend([output / "update.json", output / "MACOS-RELEASE.txt"])
    (output / checksum_name(channel)).write_text(
        "".join(f"{checksum(path)}  {path.name}\n" for path in files)
    )


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("version")
    parser.add_argument("output", type=Path)
    parser.add_argument("--sign-feed", action="store_true")
    parser.add_argument("--macos-mode", choices=["unsigned", "signed"])
    parser.add_argument(
        "--channel",
        choices=["validation", "server", "desktop", "macos", "container"],
        default="validation",
    )
    args = parser.parse_args()
    prepare(args.version, args.output, args.sign_feed, args.channel, args.macos_mode)
