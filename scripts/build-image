#!/usr/bin/env python3
"""Build a versioned linux/arm64 OCI desktop image in an isolated Apple VM."""

import gzip, hashlib, json, os, pathlib, shutil, subprocess

R = pathlib.Path(__file__).resolve().parents[1]
resources = R / ".local/d1/resources"
assets = [
    "desktop.sh",
    "desktop-config.sh",
    "desktop-session.sh",
    "pot-wallpaper.svg",
    "packages.lock",
    "test.html",
    "home.html",
    "driver.py",
    "broker.py",
    "index.html",
    "close-browser.py",
    "open-browser.sh",
    "pot-runtime",
    "agy",
    "novnc.tar.gz",
    "pi-package.json",
    "pi-package-lock.json",
]
# Read source assets directly so bundle cannot accidentally reuse stale prepare output.
for n in assets:
    source = R / "image" / n
    if n.startswith("pi-package"):
        source = R / "image/pi" / n.removeprefix("pi-")
    if source.is_file():
        shutil.copy2(source, resources / n)
fingerprint = hashlib.sha256()
for source in [
    R / "image/build.sh",
    R / "helper/Sources/PotImageBuilder/main.swift",
    pathlib.Path(__file__),
]:
    fingerprint.update(source.read_bytes())
for n in assets:
    fingerprint.update(n.encode())
    fingerprint.update((resources / n).read_bytes())
version = fingerprint.hexdigest()[:20]
reference = "pot.local/sandbox:" + version
meta = resources / "sandbox-image.json"
if (
    meta.exists()
    and json.loads(meta.read_text()).get("reference") == reference
    and (resources / "sandbox-image/index.json").exists()
    and (resources / "init-image/index.json").exists()
):
    print("Using cached image " + reference)
    raise SystemExit(0)
build = R / ".local/d1/image-build"
build.mkdir(exist_ok=True)
inputs = build / version
inputs.mkdir(exist_ok=True)
(inputs / "assets").mkdir(exist_ok=True)
for n in assets:
    shutil.copy2(resources / n, inputs / "assets" / n)
shutil.copy2(R / "image/build.sh", inputs / "build.sh")
helper = R / ".local/d1/helper-build/release/PotImageBuilder"
subprocess.run(
    [
        "codesign",
        "--force",
        "--sign",
        "-",
        "--entitlements",
        str(R / "helper/virtualization.entitlements"),
        str(helper),
    ],
    check=True,
)
if (inputs / "init-image").exists():
    shutil.rmtree(inputs / "init-image")
subprocess.run([str(helper), str(build / "store"), str(resources), str(inputs)], check=True)
layout = inputs / "sandbox-image"
if layout.exists():
    shutil.rmtree(layout)
blobs = layout / "blobs/sha256"
blobs.mkdir(parents=True)


def obj(value, kind):
    b = json.dumps(value, separators=(",", ":")).encode()
    h = hashlib.sha256(b).hexdigest()
    (blobs / h).write_bytes(b)
    return {"mediaType": "application/vnd.oci." + kind, "digest": "sha256:" + h, "size": len(b)}


raw = hashlib.sha256()
compressed = inputs / "rootfs.tar.gz"
with (inputs / "rootfs.tar").open("rb") as src, compressed.open("wb") as out:
    with gzip.GzipFile(fileobj=out, mode="wb", compresslevel=6, mtime=0, filename="") as dst:
        while chunk := src.read(1024 * 1024):
            raw.update(chunk)
            dst.write(chunk)
hashzip = hashlib.sha256()
with compressed.open("rb") as f:
    while chunk := f.read(1024 * 1024):
        hashzip.update(chunk)
h = hashzip.hexdigest()
shutil.move(compressed, blobs / h)
layer = {
    "mediaType": "application/vnd.oci.image.layer.v1.tar+gzip",
    "digest": "sha256:" + h,
    "size": (blobs / h).stat().st_size,
}
config = obj(
    {
        "architecture": "arm64",
        "os": "linux",
        "config": {
            "Env": [
                "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
                "LANG=C.UTF-8",
                "LC_ALL=C.UTF-8",
            ],
            "Cmd": ["/bin/sh", "/opt/pot/desktop.sh"],
        },
        "rootfs": {"type": "layers", "diff_ids": ["sha256:" + raw.hexdigest()]},
    },
    "image.config.v1+json",
)
manifest = obj(
    {
        "schemaVersion": 2,
        "mediaType": "application/vnd.oci.image.manifest.v1+json",
        "config": config,
        "layers": [layer],
    },
    "image.manifest.v1+json",
)
manifest["platform"] = {"architecture": "arm64", "os": "linux"}
manifest["annotations"] = {
    "org.opencontainers.image.ref.name": reference,
    "io.containerd.image.name": reference,
}
(layout / "index.json").write_text(json.dumps({"schemaVersion": 2, "manifests": [manifest]}))
(layout / "oci-layout").write_text('{"imageLayoutVersion":"1.0.0"}')
metadata = {
    "reference": reference,
    "compressed_bytes": layer["size"],
    "rootfs_tar_bytes": (inputs / "rootfs.tar").stat().st_size,
    "source_hash": version,
    "manifest_digest": manifest["digest"],
}
for name in ["sandbox-image", "init-image"]:
    target = resources / name
    if target.exists():
        shutil.rmtree(target)
    shutil.copytree(inputs / name, target)
meta.write_text(json.dumps(metadata, indent=2) + "\n")
print(json.dumps(metadata))
