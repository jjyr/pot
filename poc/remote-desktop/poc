#!/usr/bin/env python3
"""Isolated remote Docker POC. Connection details belong in Machines, not this file."""
import argparse, hashlib, json, os, pathlib, shlex, subprocess, sys, urllib.request
SOURCE=pathlib.Path(__file__).resolve().parent
ROOT=pathlib.Path(os.environ.get('POT_POC_ROOT', SOURCE.parents[1]/'.local/poc')).expanduser().resolve()/'remote-desktop'
ROOT.mkdir(parents=True,exist_ok=True)
HOST=os.environ.get('POT_REMOTE_SSH')
REMOTE='deployments/pot-poc/remote-desktop'
NAME='pot-p2-desktop'
PORT=int(os.environ.get('POT_REMOTE_PORT','17680'))
LOCAL=int(os.environ.get('POT_LOCAL_PORT','17680'))
LABEL='dev.pot.poc=remote-desktop-p2'
NOVNC='5066103959ef4e9b10f37e5a148627360dd8414e4cf8a7db92bdbd022e728aaa'
def run(args,**kwargs):return subprocess.run(args,check=True,**kwargs)
def remote(args,capture=False):
    if not HOST:raise SystemExit('Set POT_REMOTE_SSH using your Machines inventory SSH destination.')
    if HOST.startswith('-'):raise SystemExit('Invalid SSH destination')
    return run(['ssh','-o','BatchMode=yes','-o','ConnectTimeout=10',HOST,shlex.join(args)],capture_output=capture,text=capture)
def docker(*args,capture=False):return remote(['docker',*args],capture)
def owned():
    result=docker('inspect','--format','{{index .Config.Labels "dev.pot.poc"}}',NAME,capture=True)
    if result.stdout.strip()!='remote-desktop-p2':raise SystemExit('Refusing to modify a container not labelled as this POC.')
p=argparse.ArgumentParser();p.add_argument('command',choices=['doctor','build','run','status','logs','stop','remove','tunnel','untunnel','driver']);p.add_argument('args',nargs='*');a=p.parse_args()
if a.command=='doctor':
    remote(['sh','-c','uname -sm; docker version --format "{{.Server.Version}}"; df -h /; free -m'])
elif a.command=='build':
    archive=ROOT/'novnc.tar.gz'
    if not archive.exists():urllib.request.urlretrieve('https://github.com/novnc/noVNC/archive/refs/tags/v1.6.0.tar.gz',archive)
    if hashlib.sha256(archive.read_bytes()).hexdigest()!=NOVNC:raise SystemExit('noVNC archive checksum mismatch')
    remote(['mkdir','-p',REMOTE])
    bundle=ROOT/'source.tar.gz';run(['tar','czf',str(bundle),'-C',str(SOURCE),'.'])
    run(['scp',str(bundle),str(archive),HOST+':'+REMOTE+'/'])
    remote(['sh','-c','cd '+shlex.quote(REMOTE)+' && tar xzf source.tar.gz && docker build -t pot-remote-desktop:p2 .'])
    image=docker('image','inspect','--format','{{.Id}}','pot-remote-desktop:p2',capture=True).stdout.strip()
    (ROOT/'image-id').write_text(image+'\n')
    remote(['sh','-c','docker image inspect --format "{{.Id}}" pot-remote-desktop:p2 > '+REMOTE+'/image-id'])
elif a.command=='run':
    image=remote(['cat',REMOTE+'/image-id'],True).stdout.strip()
    if not image.startswith('sha256:'):raise SystemExit('Missing pinned image ID; run build first')
    # Dedicated volumes persist across remove/run; ordinary stop never deletes data.
    for suffix in ['workspace','profile']:
        volume=NAME+'-'+suffix
        exists=docker('volume','ls','--filter','name=^'+volume+'$','--format','{{.Name}}',capture=True).stdout.strip()
        if exists:
            label=docker('volume','inspect','--format','{{index .Labels "dev.pot.poc"}}',volume,capture=True).stdout.strip()
            if label!='remote-desktop-p2':raise SystemExit('Volume belongs to another task')
        else:docker('volume','create','--label',LABEL,volume)
    existing=docker('network','ls','--filter','name=^'+NAME+'$','--format','{{.Name}}',capture=True).stdout.strip()
    if not existing:docker('network','create','--label',LABEL,NAME)
    else:
        label=docker('network','inspect','--format','{{index .Labels "dev.pot.poc"}}',NAME,capture=True).stdout.strip()
        if label!='remote-desktop-p2':raise SystemExit('Network belongs to another task')
    args=['run','-d','--name',NAME,'--label',LABEL,'--network',NAME,'--memory','3g','--cpus','2','--pids-limit','256','--shm-size','512m','--cap-drop','ALL','--security-opt','no-new-privileges=true','--publish',f'127.0.0.1:{PORT}:6080','--mount',f'type=volume,source={NAME}-workspace,target=/workspace','--mount',f'type=volume,source={NAME}-profile,target=/profile','--log-opt','max-size=5m','--log-opt','max-file=2']
    if os.environ.get('POT_CHROMIUM_SECCOMP','1')=='1':
        path=remote(['realpath',REMOTE+'/seccomp-chromium.json'],True).stdout.strip();args+=['--security-opt','seccomp='+path]
    docker(*args,image)
    remote(['sh','-c', 'for i in $(seq 1 40); do docker exec '+NAME+' curl -fsS http://127.0.0.1:9222/json/version >/dev/null 2>&1 && exit 0; sleep .5; done; echo "Browser not ready; run logs" >&2; exit 1'])
elif a.command=='status':
    owned();docker('inspect','--format','{{json .State}}',NAME);docker('stats','--no-stream',NAME)
elif a.command=='logs':
    owned();docker('logs','--tail','12',NAME)
    target=REMOTE+'/chromium-last.log'
    docker('cp',NAME+':/workspace/logs/chromium.log',target)
    remote(['tail','-30',target])
elif a.command in ['stop','remove']:
    owned();docker('stop','--timeout','15',NAME)
    if a.command=='remove':docker('rm',NAME)
elif a.command=='driver':
    owned();docker('exec',NAME,'python3','/opt/pot/driver.py',*a.args)
elif a.command=='tunnel':
    if not HOST:raise SystemExit('Set POT_REMOTE_SSH')
    control=str(ROOT/'ssh-control')
    run(['ssh','-M','-S',control,'-fNT','-o','BatchMode=yes','-o','ExitOnForwardFailure=yes','-o','ServerAliveInterval=15','-o','ServerAliveCountMax=3','-L',f'127.0.0.1:{LOCAL}:127.0.0.1:{PORT}',HOST])
    print(f'http://127.0.0.1:{LOCAL}/vnc.html?autoconnect=1&resize=scale')
elif a.command=='untunnel':
    if not HOST:raise SystemExit('Set POT_REMOTE_SSH')
    run(['ssh','-S',str(ROOT/'ssh-control'),'-O','exit',HOST])
