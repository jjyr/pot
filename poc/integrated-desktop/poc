#!/usr/bin/env python3
import hashlib,json,os,pathlib,signal,subprocess,sys,tarfile,time,urllib.request,venv
SOURCE=pathlib.Path(__file__).resolve().parent;REPO=SOURCE.parents[1]
ROOT=pathlib.Path(os.environ.get('POT_POC_ROOT',REPO/'.local/poc')).resolve();DATA=ROOT/'integrated';DATA.mkdir(parents=True,exist_ok=True)
PYTHON=ROOT/'integrated-venv/bin/python';STATE=DATA/'process.json'
def call(args,**kw):return subprocess.run([str(a) for a in args],check=True,**kw)
def active():
 if not STATE.exists():return None
 state=json.loads(STATE.read_text());p=subprocess.run(['ps','-p',str(state['pid']),'-o','command='],capture_output=True,text=True)
 return state if p.returncode==0 and str(SOURCE/'broker.py') in p.stdout else None
cmd=sys.argv[1] if len(sys.argv)>1 else 'help'
if cmd=='prepare':
 if not PYTHON.exists():venv.create(ROOT/'integrated-venv',with_pip=True)
 call([PYTHON,'-m','pip','install','-r',SOURCE/'requirements.txt'])
 archive=DATA/'novnc.tar.gz'
 if not archive.exists():urllib.request.urlretrieve('https://github.com/novnc/noVNC/archive/refs/tags/v1.6.0.tar.gz',archive)
 if hashlib.sha256(archive.read_bytes()).hexdigest()!='5066103959ef4e9b10f37e5a148627360dd8414e4cf8a7db92bdbd022e728aaa':raise SystemExit('noVNC checksum mismatch')
 if not (DATA/'novnc').exists():
  with tarfile.open(archive) as f:
   for m in f.getmembers():
    if m.name.startswith('/') or '..' in pathlib.PurePosixPath(m.name).parts:raise SystemExit('Invalid archive')
   f.extractall(DATA)
  (DATA/'noVNC-1.6.0').rename(DATA/'novnc')
elif cmd=='run':
 if active():raise SystemExit('Broker already running')
 if not os.environ.get('POT_REMOTE_SSH'):raise SystemExit('Set POT_REMOTE_SSH from Machines')
 (DATA/'url').unlink(missing_ok=True)
 with (DATA/'broker.log').open('ab') as f:p=subprocess.Popen([str(PYTHON),str(SOURCE/'broker.py')],env=dict(os.environ,POT_INTEGRATED_ROOT=str(DATA)),stdout=f,stderr=f,start_new_session=True)
 STATE.write_text(json.dumps({'pid':p.pid}))
 for _ in range(100):
  if p.poll() is not None:raise SystemExit('Broker failed; inspect '+str(DATA/'broker.log'))
  if (DATA/'url').exists():break
  time.sleep(.1)
 else:raise SystemExit('Broker readiness timeout')
 print('Broker started on loopback17681; use open to show the native viewer.')
elif cmd=='open':
 url=(DATA/'url').read_text();call([REPO/'poc/macos-shell/poc','run'],env=dict(os.environ,POT_VIEWER_URL=url))
elif cmd=='status':
 token=(DATA/'url').read_text().split('#')[1]
 print(urllib.request.urlopen(urllib.request.Request('http://127.0.0.1:17681/api/status',headers={'X-Pot-Token':token})).read().decode())
elif cmd=='stop':
 s=active()
 if s:
  os.kill(s['pid'],signal.SIGTERM)
  for _ in range(80):
   if not active():break
   time.sleep(.1)
  else:raise SystemExit('Broker still stopping; inspect before retry')
 STATE.unlink(missing_ok=True)
else:print('Usage: poc prepare|run|open|status|stop (requires P2 container + SSH tunnel)')
