#!/usr/bin/env python3
import hashlib,os,pathlib,plistlib,shutil,subprocess,sys,urllib.request
SOURCE=pathlib.Path(__file__).resolve().parent;REPO=SOURCE.parents[1]
ROOT=pathlib.Path(os.environ.get('POT_POC_ROOT',REPO/'.local/poc')).resolve();ROOT.mkdir(parents=True,exist_ok=True)
RES=ROOT/'local-resources';RES.mkdir(exist_ok=True)
APP=ROOT/'pot Local POC.app'
def call(args,**kw):return subprocess.run([str(a) for a in args],check=True,**kw)
def verify(path,sha):
 if hashlib.sha256(path.read_bytes()).hexdigest()!=sha:raise SystemExit('Checksum mismatch: '+str(path))
cmd=sys.argv[1] if len(sys.argv)>1 else 'help'
if cmd=='prepare':
 kernel=RES/'vmlinux'
 if not kernel.exists():
  source=os.environ.get('POT_KERNEL_PATH')
  if source:shutil.copy2(source,kernel)
  else:
   archive=RES/'kata.tar.zst'
   if not archive.exists():urllib.request.urlretrieve('https://github.com/kata-containers/kata-containers/releases/download/3.32.0/kata-static-3.32.0-arm64.tar.zst',archive)
   verify(archive,'8736c054d9223974735394f822000823baef509e1c33405ec798240fa9b6e4b5')
   with kernel.open('wb') as f:call(['tar','xOf',archive,'opt/kata/share/kata-containers/vmlinux-6.18.35-197-debug'],stdout=f)
 verify(kernel,'fb2cfb79eb1ae19447a85d75682d7fa5cfec97e24beb2609a492b806e8072c8d')
 archive=RES/'novnc.tar.gz'
 if not archive.exists():urllib.request.urlretrieve('https://github.com/novnc/noVNC/archive/refs/tags/v1.6.0.tar.gz',archive)
 verify(archive,'5066103959ef4e9b10f37e5a148627360dd8414e4cf8a7db92bdbd022e728aaa')
 for name in ['desktop.sh','packages.lock']:shutil.copy2(SOURCE/name,RES/name)
 shutil.copy2(REPO/'poc/remote-desktop/assets/test.html',RES/'test.html')
 shutil.copy2(REPO/'poc/remote-desktop/driver.py',RES/'driver.py')
 shutil.copy2(REPO/'poc/integrated-desktop/broker.py',RES/'broker.py')
 shutil.copy2(REPO/'poc/integrated-desktop/assets/index.html',RES/'index.html')
elif cmd=='build':
 for name in ['swift-cache','swift-config','swift-security','swift-modules','clang-modules']:(ROOT/name).mkdir(exist_ok=True)
 call(['swift','build','--package-path',SOURCE,'--disable-sandbox','--scratch-path',ROOT/'helper-build','--cache-path',ROOT/'swift-cache','--config-path',ROOT/'swift-config','--security-path',ROOT/'swift-security','--force-resolved-versions','-j','4'],env=dict(os.environ,SWIFTPM_MODULECACHE_OVERRIDE=str(ROOT/'swift-modules'),CLANG_MODULE_CACHE_PATH=str(ROOT/'clang-modules')))
 call([REPO/'poc/macos-shell/poc','build'])
elif cmd=='bundle':
 for sub in ['MacOS','Helpers','Resources/runtime']:(APP/'Contents'/sub).mkdir(parents=True,exist_ok=True)
 for src,dest in [(ROOT/'cargo-target/debug/pot-macos-shell',APP/'Contents/MacOS/pot-macos-shell'),(ROOT/'helper-build/debug/PotHelper',APP/'Contents/Helpers/PotHelper')]:
  tmp=dest.with_suffix('.new');shutil.copy2(src,tmp);tmp.replace(dest)
 for name in ['vmlinux','desktop.sh','test.html','novnc.tar.gz','packages.lock','broker.py','driver.py','index.html']:shutil.copy2(RES/name,APP/'Contents/Resources/runtime'/name)
 (APP/'Contents/Info.plist').write_bytes(plistlib.dumps(dict(CFBundleIdentifier='dev.pot.local-poc',CFBundleName='pot Local POC',CFBundleExecutable='pot-macos-shell',CFBundlePackageType='APPL',CFBundleVersion='1',NSHighResolutionCapable=True,NSAppTransportSecurity={'NSAllowsLocalNetworking':True})))
 call(['codesign','--force','--sign','-','--entitlements',REPO/'poc/baseline/virtualization.entitlements',APP/'Contents/Helpers/PotHelper'])
 call(['codesign','--force','--sign','-',APP]);call(['codesign','--verify','--deep','--strict',APP]);print(APP)
elif cmd=='open':call(['open',APP])
else:print('Usage: poc prepare|build|bundle|open; runtime is app-owned, stop via native Stop/Quit')
