#!/usr/bin/env python3
"""Task-local build/run/stop; no shell profile or HOME overrides."""
import datetime, fcntl, json, os, pathlib, plistlib, shutil, signal, subprocess, sys, time, uuid
SOURCE = pathlib.Path(__file__).resolve().parent
ROOT = pathlib.Path(os.environ.get('POT_POC_ROOT', SOURCE.parents[1] / '.local/poc')).expanduser().resolve()
ROOT.mkdir(parents=True, exist_ok=True)
LOCK = (ROOT / 'macos-shell.lock').open('a')
try:
    fcntl.flock(LOCK, fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError:
    raise SystemExit('Another POC entry is running for this root; retry after it finishes.')
STATE = ROOT / 'macos-shell.json'
ENV = dict(os.environ, CARGO_TARGET_DIR=str(ROOT / 'cargo-target'), RUSTC_WRAPPER='')
BUILT = ROOT / 'cargo-target/debug/pot-macos-shell'
BUNDLE = ROOT / 'pot POC.app'
BINARY = BUNDLE / 'Contents/MacOS/pot-macos-shell'
def bundle():
    BINARY.parent.mkdir(parents=True, exist_ok=True)
    temporary = BINARY.with_suffix('.new')
    shutil.copy2(BUILT, temporary)
    temporary.replace(BINARY)
    (BUNDLE/'Contents/Info.plist').write_bytes(plistlib.dumps(dict(CFBundleIdentifier='dev.pot.macos-shell', CFBundleName='pot POC', CFBundleExecutable='pot-macos-shell', CFBundlePackageType='APPL', CFBundleVersion='1', NSHighResolutionCapable=True)))
    call(['codesign', '--force', '--sign', '-', str(BUNDLE)])
def call(args, **kwargs): return subprocess.run(args, check=True, env=ENV, **kwargs)
def doctor():
    if sys.platform != 'darwin': raise SystemExit('macOS required')
    for tool in ['xcrun', 'swiftc', 'rustc', 'cargo', 'codesign', 'ps']:
        if not shutil.which(tool): raise SystemExit('Missing '+tool+'; install Xcode command-line tools and Rust, then retry doctor.')
    for cmd in [['uname','-sm'], ['sw_vers'], ['xcrun','--show-sdk-version'], ['xcrun','swiftc','--version'], ['rustc','--version'], ['cargo','--version']]: call(cmd)
    print('POC root:', ROOT, '\nNo TCP ports required. Xcode SDK and Rust >= 1.88 required.')
def active():
    if not STATE.exists(): return None
    state=json.loads(STATE.read_text())
    try:
        result=subprocess.run(['ps','-p',str(state['pid']),'-o','command='],capture_output=True,text=True)
    except PermissionError:
        raise SystemExit('Process inspection blocked by sandbox; run this entry in a normal macOS terminal.')
    return state if result.returncode == 0 and result.stdout.strip() == state['binary'] else None
cmd=sys.argv[1] if len(sys.argv)>1 else 'help'
if cmd == 'doctor': doctor()
elif cmd == 'build':
    doctor(); call(['cargo','build','--locked','--manifest-path',str(SOURCE/'Cargo.toml'),'-j','4'])
elif cmd == 'run':
    if active(): raise SystemExit('Already running; use stop first.')
    if not BUILT.exists(): raise SystemExit('Run ./poc build first.')
    bundle()
    run_id=datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%SZ')+'-'+uuid.uuid4().hex[:8]
    log=ROOT / (run_id+'.jsonl')
    with log.open('wb') as output:
        process=subprocess.Popen([str(BINARY)],env=dict(ENV,POT_RUN_ID=run_id),stdout=output,stderr=subprocess.STDOUT,start_new_session=True)
    STATE.write_text(json.dumps(dict(pid=process.pid,binary=str(BINARY),run_id=run_id,log=str(log)),indent=2))
    for _ in range(100):
        if process.poll() is not None: raise SystemExit('Startup failed (exit '+str(process.returncode)+'); inspect '+str(log))
        if '"event":"web.ready"' in log.read_text(errors='replace'): break
        time.sleep(.1)
    else:
        process.terminate()
        process.wait(timeout=5)
        raise SystemExit('WebView readiness timed out; inspect '+str(log))
    print(STATE.read_text())
elif cmd == 'stop':
    state=active()
    if state:
        os.kill(state['pid'],signal.SIGTERM)
        for _ in range(50):
            if not active(): break
            time.sleep(.1)
        else: raise SystemExit('Still running; inspect process before retrying.')
        print('Stopped owned GUI process. No helper/VM/listener is started by this slice.')
    else: print('No matching owned process running.')
    STATE.unlink(missing_ok=True)
elif cmd == 'status': print(json.dumps(active(),indent=2))
else: print('Usage: ./poc doctor|build|run|status|stop')
