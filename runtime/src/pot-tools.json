[
  {
    "name": "pot_create_task",
    "description": "Create a background task and immediately return its ID. Include goal, context, constraints and deliverables in text. resource shared serializes tasks using shared resources.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "resource": {
          "type": "string",
          "enum": [
            "",
            "shared"
          ]
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "pot_list_tasks",
    "description": "Search task metadata by state and title/ID. Defaults to active tasks, 10 per page; archived tasks keep complete/cancelled status. Use attention for failed/interrupted, archived to find past results, all only with a relevant query. Follow next_offset only when needed; no polling.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "active",
            "attention",
            "archived",
            "all"
          ]
        },
        "phase": {
          "type": "string",
          "description": "Exact execution status; overrides scope when provided",
          "enum": [
            "queued",
            "running",
            "waiting",
            "complete",
            "failed",
            "cancelled",
            "interrupted"
          ]
        },
        "q": {
          "type": "string",
          "maxLength": 256,
          "description": "Case-insensitive title or task ID substring"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "pot_get_task",
    "description": "Read recent results and execution state of a task.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "task_id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "pot_guide_task",
    "description": "Queue a follow-up instruction in an existing task. Applied after the current turn; does not interrupt it.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "task_id",
        "text"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "pot_cancel_task",
    "description": "Cancel a task and discard queued instructions. Running work may still be stopping.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "task_id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "pot_list_schedules",
    "description": "List scheduled plans (metadata only). Filter enabled/paused/all; use pagination.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "enabled",
            "paused",
            "all"
          ]
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "pot_get_schedule",
    "description": "Read a schedule definition and paginated execution history.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "schedule_id": {
          "type": "string",
          "minLength": 1
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "required": [
        "schedule_id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "pot_manage_schedule",
    "description": "Create/update/pause/resume/delete/run a persistent schedule. Pausing/deleting prevents future triggers and does not cancel current work. An immediate run is non-overlapping. All times use the specified IANA timezone. Runtime runs only while the Sandbox is available, with recovery policy on restart. Creation/update requires spec. Deletion is soft and keeps execution history.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "create",
            "update",
            "pause",
            "resume",
            "delete",
            "run"
          ]
        },
        "schedule_id": {
          "type": "string",
          "minLength": 1
        },
        "spec": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "goal": {
              "type": "string",
              "minLength": 1
            },
            "timezone": {
              "type": "string",
              "description": "IANA name, e.g. Asia/Shanghai"
            },
            "kind": {
              "type": "string",
              "enum": [
                "once",
                "interval",
                "daily",
                "weekly"
              ]
            },
            "at": {
              "type": "string",
              "description": "once: local YYYY-MM-DD HH:MM"
            },
            "every_minutes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 525600
            },
            "time": {
              "type": "string",
              "description": "daily/weekly: local HH:MM"
            },
            "weekdays": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 7
              },
              "description": "weekly: Monday=1 through Sunday=7"
            },
            "misfire": {
              "type": "string",
              "enum": [
                "coalesce",
                "skip"
              ]
            },
            "notify": {
              "type": "string",
              "enum": [
                "changes",
                "all",
                "failures"
              ]
            },
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "title",
            "goal",
            "timezone",
            "kind"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    }
  }
]
