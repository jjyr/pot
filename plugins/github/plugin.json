{
  "schema_version": 3,
  "version": "0.1.0",
  "contributes": {
    "background": {
      "runtime": "node",
      "execution": "control",
      "entrypoint": "notifications.mjs",
      "files": [
        "notifications.mjs",
        "filters.mjs"
      ],
      "credentials": {
        "GH_TOKEN": {
          "service": "github"
        }
      },
      "event_routing": true
    },
    "mcp": {
      "runtime": "node",
      "execution": "control",
      "entrypoint": "mcp.mjs",
      "files": [
        "mcp.mjs",
        "subscriptions.mjs",
        "filters.mjs",
        "read-notifications.mjs",
        "read-tool.json"
      ],
      "credentials": {
        "GH_TOKEN": {
          "service": "github"
        }
      },
      "configuration": {
        "list": "list_subscriptions",
        "create": "create_subscription",
        "update": "update_subscription",
        "delete": "delete_subscription"
      }
    }
  },
  "name": "github"
}
