[
  {
    "name": "create_task",
    "description": "Create a background task and immediately return its ID. Include goal, context, constraints and deliverables in text. resource shared serializes tasks using shared resources. Interpret the applicable AGENTS.md routing rules semantically using eligible configured Profiles. Explicit current-task choices take precedence; otherwise leave unmatched work on existing defaults. Never silently substitute an unavailable preferred executor.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "resource": {
          "type": "string",
          "enum": [
            "",
            "shared"
          ]
        },
        "profile": {
          "type": "string",
          "minLength": 1,
          "description": "Eligible, user-allow-listed Profile ID selected for this task; omitted retains default routing. Use a real configured connection/model, not a provider name."
        },
        "requirements": {
          "type": "object",
          "properties": {
            "tools": {
              "type": "boolean"
            },
            "desktop": {
              "type": "boolean"
            },
            "exact_budget": {
              "type": "boolean"
            },
            "live_steering": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "selection_reason": {
          "type": "string",
          "maxLength": 512,
          "description": "Concise creation-time reason for the chosen executor; do not claim certainty for ambiguous work."
        },
        "sandbox_id": {
          "type": "string",
          "description": "Local Sandbox selection; use environment_ref for a full Host or Sandbox destination. Cannot combine both. Omitted snapshots the Agent Runtime execution default."
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Optional skill names restricting this task. Omitted automatically discovers global task/shared and project skills."
        },
        "environment_ref": {
          "type": "object",
          "properties": {
            "runtime_id": {
              "type": "string"
            },
            "target": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "host"
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "sandbox"
                    },
                    "sandbox_id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "sandbox_id"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "runtime_id",
            "target"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "list_tasks",
    "description": "Search task metadata by state and title/ID. Defaults to active tasks, 10 per page; archived tasks keep complete/cancelled status. Use attention for failed/interrupted, archived to find past results, all only with a relevant query. Follow next_offset only when needed; no polling.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "active",
            "attention",
            "archived",
            "all"
          ]
        },
        "phase": {
          "type": "string",
          "description": "Exact execution status; overrides scope when provided",
          "enum": [
            "queued",
            "running",
            "waiting",
            "complete",
            "failed",
            "cancelled",
            "interrupted"
          ]
        },
        "q": {
          "type": "string",
          "maxLength": 256,
          "description": "Case-insensitive title or task ID substring"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "get_task",
    "description": "Read recent results and execution state of a task.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "task_id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "guide_task",
    "description": "Queue a follow-up instruction in an existing task. Applied after the current turn; does not interrupt it.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "task_id",
        "text"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "send_message",
    "description": "Send reference information from Main to a pot-agent task. Delivered at a safe model boundary if running, or retained for its next explicit guide_task continuation. Does not create a work turn, interrupt current work, resume stopped tasks or authorize new permissions. Sender identity is trusted Runtime metadata, not caller supplied.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        }
      },
      "required": [
        "task_id",
        "text"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "wait_task",
    "description": "Wait for any of up to eight tasks to complete, fail, become interrupted, cancelled or allowance-waiting. Bounded wait; no busy polling. Returns metadata, per-task cursors and timed_out. Pass returned cursors as after to suppress unchanged settled states. Does not retrieve transcripts, resume tasks or wait for exec; use wait for JavaScript runs.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "task_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        },
        "after": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        }
      },
      "required": [
        "task_ids"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "interrupt",
    "description": "Interrupt current work while retaining task/session/files and pending guidance. Does not replay interrupted input or automatically resume. Running work retains capacity until cleanup is confirmed; guide_task explicitly resumes. Completed task results remain complete.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "task_id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "cancel_task",
    "description": "Abandon a task: stop current execution, discard pending guidance and mark cancelled after confirmed cleanup. Retains history and files; cancelled tasks appear in Archived. Use interrupt to preserve guidance for later continuation. Completed results remain complete.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "task_id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "list_schedules",
    "description": "List scheduled plans (metadata only). Filter enabled/paused/all; use pagination.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "enabled",
            "paused",
            "all"
          ]
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "get_schedule",
    "description": "Read a schedule definition and paginated execution history.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "schedule_id": {
          "type": "string",
          "minLength": 1
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "required": [
        "schedule_id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "manage_schedule",
    "description": "Create/update/pause/resume/delete/run a persistent schedule. Pausing/deleting prevents future triggers and does not cancel current work. An immediate run is non-overlapping. All times use the specified IANA timezone. Triggers run while Host Runtime is available; environment tools lazily prepare the saved Sandbox, with recovery policy on restart. Creation/update requires spec. Deletion is soft and keeps execution history.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "create",
            "update",
            "pause",
            "resume",
            "delete",
            "run"
          ]
        },
        "schedule_id": {
          "type": "string",
          "minLength": 1
        },
        "spec": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "goal": {
              "type": "string",
              "minLength": 1
            },
            "timezone": {
              "type": "string",
              "description": "IANA name, e.g. Asia/Shanghai"
            },
            "kind": {
              "type": "string",
              "enum": [
                "once",
                "interval",
                "daily",
                "weekly"
              ]
            },
            "at": {
              "type": "string",
              "description": "once: local YYYY-MM-DD HH:MM"
            },
            "every_minutes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 525600
            },
            "time": {
              "type": "string",
              "description": "daily/weekly: local HH:MM"
            },
            "weekdays": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 7
              },
              "description": "weekly: Monday=1 through Sunday=7"
            },
            "misfire": {
              "type": "string",
              "enum": [
                "coalesce",
                "skip"
              ]
            },
            "notify": {
              "type": "string",
              "enum": [
                "changes",
                "all",
                "failures"
              ]
            },
            "enabled": {
              "type": "boolean"
            },
            "profile": {
              "type": "string",
              "minLength": 1,
              "description": "Optional user-allow-listed profile hint; omitted uses the worker default."
            },
            "requirements": {
              "type": "object",
              "properties": {
                "tools": {
                  "type": "boolean"
                },
                "desktop": {
                  "type": "boolean"
                },
                "exact_budget": {
                  "type": "boolean"
                },
                "live_steering": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            "sandbox_id": {
              "type": "string",
              "description": "Creation snapshots the current execution default when omitted. Update retains the saved environment when omitted."
            }
          },
          "required": [
            "title",
            "goal",
            "timezone",
            "kind"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "list_environments",
    "description": "Inspect authorized Host and Sandbox environments grouped by Runtime; does not start an environment.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "manage_sandbox",
    "description": "Main-only Sandbox lifecycle and selection. Workers cannot manage or switch environments. Busy environments cannot be stopped. Creating a definition does not boot a VM. Update requires name and config, and a stopped or failed environment with no active operations. Resources apply at next start.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "create",
            "start",
            "desktop",
            "stop",
            "delete",
            "recover",
            "select",
            "update"
          ]
        },
        "sandbox_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "config": {
          "type": "object",
          "properties": {
            "cpus": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            "memory_gib": {
              "type": "integer",
              "minimum": 1,
              "maximum": 128
            },
            "disk_gib": {
              "type": "integer",
              "minimum": 4,
              "maximum": 512
            }
          },
          "required": [
            "cpus",
            "memory_gib",
            "disk_gib"
          ],
          "additionalProperties": false
        },
        "provider": {
          "type": "string",
          "enum": [
            "macos.apple-containerization",
            "linux.podman",
            "macos.apple-virtualization"
          ],
          "description": "Engine for create only; defaults to Linux. macOS requires an owner-enrolled prepared VM."
        },
        "runtime_id": {
          "type": "string",
          "description": "Destination Runtime; omitted uses this Agent Runtime. Host is not a Sandbox management target."
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    }
  }
]
