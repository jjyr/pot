amends "package://github.com/jdx/hk/releases/download/v2.4.0/hk@2.4.0#/Config.pkl"

// Independent portable product, macOS, script and notice checks.
jobs = 4

hooks {
  ["pre-commit"] {
    fix = false
    steps {
      ["sources"] {
        glob = List("**/*.go", "**/*.swift", "**/*.py", "**/*.sh", "scripts/*", "mise.toml", "ruff.toml", ".swiftformat", "hk.pkl")
        check = "python scripts/timed-check pre-commit:sources mise exec -- python scripts/dev-check lint {{files}}"
      }
      ["whitespace"] {
        check = "python scripts/timed-check pre-commit:whitespace git diff --cached --check"
      }
    }
  }
  ["pre-push"] {
    fix = false
    steps {
      ["go"] {
        check = "python scripts/timed-check pre-push:go sh -c 'mise run check:go && mise run test:core'"
      }
      ["contracts"] {
        check = "python scripts/timed-check pre-push:contracts mise run test:contracts"
      }
      ["macos"] {
        check = new Script {
          macos = "python scripts/timed-check pre-push:macos sh -c 'mise run lint && mise run test:release'"
        }
      }
      ["scripts"] {
        check = "python scripts/timed-check pre-push:scripts mise run test:hooks"
      }
      ["licenses"] {
        check = "python scripts/timed-check pre-push:licenses sh -c 'mise run licenses'"
      }
    }
  }
}
