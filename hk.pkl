amends "package://github.com/jdx/hk/releases/download/v2.4.0/hk@2.4.0#/Config.pkl"

// Four independent CI groups; Cargo tasks share one sequential group.
jobs = 4

hooks {
  ["pre-commit"] {
    fix = false
    steps {
      ["sources"] {
        glob = List("**/*.rs", "**/*.swift", "**/*.py", "**/*.sh", "scripts/*", "mise.toml", "ruff.toml", ".swiftformat", "hk.pkl")
        check = "mise exec -- python scripts/dev-check lint {{files}}"
      }
      ["whitespace"] {
        check = "git diff --cached --check"
      }
    }
  }
  ["pre-push"] {
    fix = false
    steps {
      ["rust"] {
        check = new Script {
          macos = "mise run check:rust && mise run clippy:backend && mise run clippy && mise run test && mise run test:ui && mise run test:app && mise run test:eval"
          linux = "mise run clippy:backend && mise run test && mise run test:ui && mise run test:eval"
        }
      }
      ["macos"] {
        check = new Script {
          macos = "mise run lint && mise run check:swift"
        }
      }
      ["scripts"] {
        check = "mise run test:release && mise run test:executor && mise run test:skills && mise run test:skill-authoring"
      }
      ["licenses"] {
        check = "mise run licenses && mise run test:licenses"
      }
    }
  }
}
