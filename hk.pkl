amends "package://github.com/jdx/hk/releases/download/v2.4.0/hk@2.4.0#/Config.pkl"

// Four independent CI groups; Cargo tasks share one sequential group.
jobs = 4

hooks {
  ["pre-commit"] {
    fix = false
    steps {
      ["sources"] {
        glob = List("**/*.rs", "**/*.go", "**/*.swift", "**/*.py", "**/*.sh", "scripts/*", "mise.toml", "ruff.toml", ".swiftformat", "hk.pkl")
        check = "python scripts/timed-check pre-commit:sources mise exec -- python scripts/dev-check lint {{files}}"
      }
      ["whitespace"] {
        check = "python scripts/timed-check pre-commit:whitespace git diff --cached --check"
      }
    }
  }
  ["pre-push"] {
    fix = false
    steps {
      ["rust"] {
        check = new Script {
          macos = "python scripts/timed-check pre-push:rust sh -c 'mise run clippy && mise run test && mise run test:ui && mise run test:app && mise run test:eval'"
          linux = "python scripts/timed-check pre-push:rust sh -c 'mise run clippy:backend && mise run test && mise run test:ui && mise run test:eval'"
        }
      }
      ["macos"] {
        check = new Script {
          macos = "python scripts/timed-check pre-push:macos sh -c 'mise run lint && mise run check:swift'"
        }
      }
      ["scripts"] {
        check = "python scripts/timed-check pre-push:scripts sh -c 'mise run test:hooks && mise run test:release && mise run test:executor && mise run test:skills && mise run test:skill-authoring'"
      }
      ["licenses"] {
        check = "python scripts/timed-check pre-push:licenses sh -c 'mise run licenses && mise run test:licenses'"
      }
    }
  }
}
